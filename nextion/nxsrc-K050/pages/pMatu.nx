  {
  spstr pInit.tData.txt,tDay9.txt,"|",1
  spstr pInit.tData.txt,tTim9.txt,"|",3
  spstr pInit.tData.txt,tFc9.txt,"|",5
  spstr pInit.tData.txt,tT9.txt,"|",4
  pInit.vTotal.val=pInit.nAckValue.val
  }
  else
  {
  tDay9.txt=""
  tTim9.txt=""
  tFc9.txt=""
  tT9.txt=""
  }
  }
  if(pInit.vGet.val==13)
  {
  if(pInit.nAckCode.val==0)
  {
  spstr pInit.tData.txt,tDay10.txt,"|",1
  spstr pInit.tData.txt,tTim10.txt,"|",3
  spstr pInit.tData.txt,tFc10.txt,"|",5
  spstr pInit.tData.txt,tT10.txt,"|",4
  pInit.vTotal.val=pInit.nAckValue.val
  }
  else
  {
  tDay10.txt=""
  tTim10.txt=""
  tFc10.txt=""
  tT10.txt=""
  }
  }
  if(pInit.vGet.val==14)
  {
  if(pInit.nAckCode.val==0)
  {
  spstr pInit.tData.txt,tDay11.txt,"|",1
  spstr pInit.tData.txt,tTim11.txt,"|",3
  spstr pInit.tData.txt,tFc11.txt,"|",5
  spstr pInit.tData.txt,tT11.txt,"|",4
  pInit.vTotal.val=pInit.nAckValue.val
  }
  else
  {
  tDay11.txt=""
  tTim11.txt=""
  tFc11.txt=""
  tT11.txt=""
  }
  }
  pInit.vStep.val+=1
  }else
  {
  if(pInit.nAckCode.val==13)
  {
  pInit.vToken.val=pInit.nAckValue.val
  page pConfirm
  }else
  {
  if(pInit.nAckCode.val!=0)
  {
  pInit.tMsg.txt="ConMT error "
  covx pInit.nAckCode.val,pInit.tNum.txt,0,0
  pInit.tMsg.txt+=pInit.tNum.txt
  if(pInit.nAckCode.val==1)
  {
  pInit.tMsg.txt="Invalid input. Check the field format."
  }
  if(pInit.nAckCode.val==2)
  {
  pInit.tMsg.txt="Complete the required fields"
  }
  if(pInit.nAckCode.val==6)
  {
  pInit.tMsg.txt="Check the microSD card"
  }
  if(pInit.nAckCode.val==9)
  {
  pInit.tMsg.txt="Connect a temperature probe"
  }
  if(pInit.nAckCode.val==10)
  {
  pInit.tMsg.txt="Set date/time before measurement"
  }
  if(pInit.nAckCode.val==11)
  {
  pInit.tMsg.txt="Enter at least two valid lab pairs"
  }
  if(pInit.nAckCode.val==12)
  {
  pInit.tMsg.txt="Add a later checkpoint before SAVE"
  }
  }else
  {
  pInit.tMsg.txt=""
  }
  pInit.vStep.val=1
  }
  }
  }
  }
  else
  {
  pInit.vRetry.val+=1
  if(pInit.vRetry.val==15)
  {
  prints pInit.tReq.txt,0
  printh 0A
  }
  if(pInit.vRetry.val>=30)
  {
  pInit.vBusy.val=0
  pInit.nBoot.val=0
  pInit.vStep.val=0
  pInit.tMsg.txt="No answer from MCU"
  }
  }
  }
  tNotice.txt=pInit.tMsg.txt
  if(pInit.vBusy.val==0&&dp==pInit.vPage.val)
  {
  if(pInit.vStep.val==0)
  {
  pInit.vGet.val=0
  if(pInit.vBusy.val==0)
  {
  pInit.vSeq.val+=1
  pInit.nAckSeq.val=0
  pInit.vBusy.val=1
  pInit.vRetry.val=0
  pInit.vTask.val=0
  pInit.tReq.txt="CM1|"
  covx pInit.nBoot.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vSeq.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vPage.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.nView.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  pInit.tReq.txt+="PAGE_READY"
  prints pInit.tReq.txt,0
  printh 0A
  }
  }
  if(pInit.vStep.val==1)
  {
  pInit.vGet.val=1
  pInit.tCommand.txt="GET|status"
  if(pInit.vBusy.val==0)
  {
  pInit.vSeq.val+=1
  pInit.nAckSeq.val=0
  pInit.vBusy.val=1
  pInit.vRetry.val=0
  pInit.vTask.val=0
  pInit.tReq.txt="CM1|"
  covx pInit.nBoot.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vSeq.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vPage.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.nView.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  pInit.tReq.txt+=pInit.tCommand.txt
  prints pInit.tReq.txt,0
  printh 0A
  }
  }
  if(pInit.vStep.val==2)
  {
  pInit.vGet.val=2
  pInit.tCommand.txt="GET|baseline"
  if(pInit.vBusy.val==0)
  {
  pInit.vSeq.val+=1
  pInit.nAckSeq.val=0
  pInit.vBusy.val=1
  pInit.vRetry.val=0
