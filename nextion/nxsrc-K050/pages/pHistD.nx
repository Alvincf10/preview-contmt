on pHistD.loadend:
  if(pInit.vPage.val!=14)
  {
  pInit.vOffset.val=0
  }
  pInit.vPage.val=14
  pInit.vBusy.val=0
  pInit.vRetry.val=0
  pInit.vStep.val=0
  pInit.vPoll.val=0
  pInit.tMsg.txt=""

on mBack.down:
  if(pInit.vBusy.val==0)
  {
  pInit.vSeq.val+=1
  pInit.nAckSeq.val=0
  pInit.vBusy.val=1
  pInit.vRetry.val=0
  pInit.vTask.val=1
  pInit.tReq.txt="CM1|"
  covx pInit.nBoot.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vSeq.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vPage.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.nView.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  pInit.tReq.txt+="NAV|13"
  prints pInit.tReq.txt,0
  printh 0A
  }

on tmPoll.timer:
  if(pInit.vBusy.val==1)
  {
  if(pInit.nAckSeq.val==pInit.vSeq.val)
  {
  pInit.vBusy.val=0
  pInit.vRetry.val=0
  if(pInit.nAckCode.val==4||pInit.nAckCode.val==8)
  {
  pInit.nBoot.val=0
  pInit.vStep.val=0
  }else
  {
  if(pInit.vTask.val==0)
  {
  if(pInit.vGet.val==1)
  {
  if(pInit.nAckCode.val==0)
  {
  pInit.tStatus.txt=pInit.tData.txt
  spstr pInit.tData.txt,tClock.txt,"|",1
  spstr pInit.tData.txt,tBatt.txt,"|",3
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",4
  covx pInit.tSplit.txt,pInit.vStorage.val,0,0
  spstr pInit.tData.txt,pInit.tDate.txt,"|",0
  spstr pInit.tData.txt,pInit.tTime.txt,"|",1
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",14
  covx pInit.tSplit.txt,pInit.vMask.val,0,0
  pInit.vSensors.val=0
  pInit.vCount.val=pInit.vMask.val
  if(pInit.vCount.val>=4)
  {
  pInit.vSensors.val+=1
  pInit.vCount.val-=4
  }
  if(pInit.vCount.val>=2)
  {
  pInit.vSensors.val+=1
  pInit.vCount.val-=2
  }
  if(pInit.vCount.val>=1)
  {
  pInit.vSensors.val+=1
  }
  }
  }
  if(pInit.vGet.val==2)
  {
  if(pInit.nAckCode.val==0)
  {
  spstr pInit.tData.txt,tBase.txt,"|",1
  spstr pInit.tData.txt,tTarget.txt,"|",2
  spstr pInit.tData.txt,tDatum.txt,"|",3
  }
  }
  if(pInit.vGet.val==3)
  {
  if(pInit.nAckCode.val==0)
  {
  spstr pInit.tData.txt,tPDate.txt,"|",4
  spstr pInit.tData.txt,tPour.txt,"|",5
  spstr pInit.tData.txt,tInitTemp.txt,"|",8
  spstr pInit.tData.txt,tElapsed.txt,"|",9
  pInit.vRevision.val=pInit.nAckValue.val
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",2
  covx pInit.tSplit.txt,pInit.vTotal.val,0,0
  }
  }
  if(pInit.vGet.val==4)
  {
  if(pInit.nAckCode.val==0)
  {
  spstr pInit.tData.txt,tId.txt,"|",0
  spstr pInit.tData.txt,tSavedAt.txt,"|",1
  spstr pInit.tData.txt,tOp.txt,"|",3
  spstr pInit.tData.txt,tProj.txt,"|",4
  spstr pInit.tData.txt,tDate.txt,"|",2
  }
  }
  if(pInit.vGet.val==5)
  {
  if(pInit.nAckCode.val==0)
  {
  tLog0.txt="Day "
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",0
  tLog0.txt+=""
  tLog0.txt+=pInit.tSplit.txt
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",2
  tLog0.txt+=" "
  tLog0.txt+=pInit.tSplit.txt
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",3
  tLog0.txt+=" T "
  tLog0.txt+=pInit.tSplit.txt
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",4
  tLog0.txt+=" M "
  tLog0.txt+=pInit.tSplit.txt
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",5
  tLog0.txt+=" Fc "
  tLog0.txt+=pInit.tSplit.txt
  
  }
  else
  {
  tLog0.txt=""
  }
  }
  if(pInit.vGet.val==6)
  {
  if(pInit.nAckCode.val==0)
  {
  tLog1.txt="Day "
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",0
  tLog1.txt+=""
  tLog1.txt+=pInit.tSplit.txt
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",2
  tLog1.txt+=" "
  tLog1.txt+=pInit.tSplit.txt
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",3
  tLog1.txt+=" T "
  tLog1.txt+=pInit.tSplit.txt
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",4
  tLog1.txt+=" M "
  tLog1.txt+=pInit.tSplit.txt
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",5
  tLog1.txt+=" Fc "
  tLog1.txt+=pInit.tSplit.txt
  
  }
  else
  {
  tLog1.txt=""
  }
  }
  if(pInit.vGet.val==7)
  {
  if(pInit.nAckCode.val==0)
  {
  tLog2.txt="Day "
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",0
  tLog2.txt+=""
  tLog2.txt+=pInit.tSplit.txt
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",2
  tLog2.txt+=" "
  tLog2.txt+=pInit.tSplit.txt
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",3
  tLog2.txt+=" T "
  tLog2.txt+=pInit.tSplit.txt
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",4
  tLog2.txt+=" M "
  tLog2.txt+=pInit.tSplit.txt
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",5
  tLog2.txt+=" Fc "
  tLog2.txt+=pInit.tSplit.txt
  
  }
  else
  {
  tLog2.txt=""
  }
  }
  if(pInit.vGet.val==8)
  {
  if(pInit.nAckCode.val==0)
  {
  tLog3.txt="Day "
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",0
  tLog3.txt+=""
  tLog3.txt+=pInit.tSplit.txt
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",2
  tLog3.txt+=" "
  tLog3.txt+=pInit.tSplit.txt
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",3
  tLog3.txt+=" T "
  tLog3.txt+=pInit.tSplit.txt
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",4
  tLog3.txt+=" M "
  tLog3.txt+=pInit.tSplit.txt
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",5
  tLog3.txt+=" Fc "
  tLog3.txt+=pInit.tSplit.txt
  
  }
  else
  {
  tLog3.txt=""
  }
  }
  if(pInit.vGet.val==9)
  {
  if(pInit.nAckCode.val==0)
  {
  tLog4.txt="Day "
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",0
  tLog4.txt+=""
  tLog4.txt+=pInit.tSplit.txt
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",2
  tLog4.txt+=" "
  tLog4.txt+=pInit.tSplit.txt
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",3
  tLog4.txt+=" T "
  tLog4.txt+=pInit.tSplit.txt
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",4
  tLog4.txt+=" M "
  tLog4.txt+=pInit.tSplit.txt
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",5
  tLog4.txt+=" Fc "
  tLog4.txt+=pInit.tSplit.txt
  
  }
  else
  {
  tLog4.txt=""
  }
  }
  pInit.vStep.val+=1
  }else
  {
  if(pInit.nAckCode.val==13)
  {
  pInit.vToken.val=pInit.nAckValue.val
  page pConfirm
  }else
  {
  if(pInit.nAckCode.val!=0)
  {
  pInit.tMsg.txt="ConMT error "
  covx pInit.nAckCode.val,pInit.tNum.txt,0,0
  pInit.tMsg.txt+=pInit.tNum.txt
  if(pInit.nAckCode.val==1)
  {
  pInit.tMsg.txt="Invalid input. Check the field format."
  }
  if(pInit.nAckCode.val==2)
  {
  pInit.tMsg.txt="Complete the required fields"
  }
  if(pInit.nAckCode.val==6)
  {
  pInit.tMsg.txt="Check the microSD card"
  }
  if(pInit.nAckCode.val==9)
  {
  pInit.tMsg.txt="Connect a temperature probe"
  }
  if(pInit.nAckCode.val==10)
  {
  pInit.tMsg.txt="Set date/time before measurement"
  }
  if(pInit.nAckCode.val==11)
  {
  pInit.tMsg.txt="Enter at least two valid lab pairs"
  }
  if(pInit.nAckCode.val==12)
  {
  pInit.tMsg.txt="Add a later checkpoint before SAVE"
  }
  }else
  {
  pInit.tMsg.txt=""
  }
  pInit.vStep.val=1
  }
  }
  }
  }
  else
  {
  pInit.vRetry.val+=1
  if(pInit.vRetry.val==15)
  {
  prints pInit.tReq.txt,0
  printh 0A
  }
  if(pInit.vRetry.val>=30)
  {
  pInit.vBusy.val=0
  pInit.nBoot.val=0
  pInit.vStep.val=0
  pInit.tMsg.txt="No answer from MCU"
  }
  }
  }
  tNotice.txt=pInit.tMsg.txt
  if(pInit.vBusy.val==0&&dp==pInit.vPage.val)
  {
  if(pInit.vStep.val==0)
  {
  pInit.vGet.val=0
  if(pInit.vBusy.val==0)
  {
  pInit.vSeq.val+=1
  pInit.nAckSeq.val=0
  pInit.vBusy.val=1
  pInit.vRetry.val=0
  pInit.vTask.val=0
  pInit.tReq.txt="CM1|"
  covx pInit.nBoot.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vSeq.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vPage.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.nView.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  pInit.tReq.txt+="PAGE_READY"
  prints pInit.tReq.txt,0
  printh 0A
  }
  }
  if(pInit.vStep.val==1)
  {
  pInit.vGet.val=1
  pInit.tCommand.txt="GET|status"
  if(pInit.vBusy.val==0)
  {
  pInit.vSeq.val+=1
  pInit.nAckSeq.val=0
  pInit.vBusy.val=1
  pInit.vRetry.val=0
  pInit.vTask.val=0
  pInit.tReq.txt="CM1|"
  covx pInit.nBoot.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vSeq.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vPage.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.nView.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  pInit.tReq.txt+=pInit.tCommand.txt
  prints pInit.tReq.txt,0
  printh 0A
  }
  }
  if(pInit.vStep.val==2)
  {
  pInit.vGet.val=2
  pInit.tCommand.txt="GET|baseline"
  if(pInit.vBusy.val==0)
  {
  pInit.vSeq.val+=1
  pInit.nAckSeq.val=0
  pInit.vBusy.val=1
  pInit.vRetry.val=0
  pInit.vTask.val=0
  pInit.tReq.txt="CM1|"
  covx pInit.nBoot.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vSeq.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vPage.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.nView.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  pInit.tReq.txt+=pInit.tCommand.txt
  prints pInit.tReq.txt,0
  printh 0A
  }
  }
  if(pInit.vStep.val==3)
  {
  pInit.vGet.val=3
  pInit.tCommand.txt="GET|run"
  if(pInit.vBusy.val==0)
  {
  pInit.vSeq.val+=1
  pInit.nAckSeq.val=0
  pInit.vBusy.val=1
  pInit.vRetry.val=0
  pInit.vTask.val=0
  pInit.tReq.txt="CM1|"
  covx pInit.nBoot.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vSeq.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vPage.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.nView.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  pInit.tReq.txt+=pInit.tCommand.txt
  prints pInit.tReq.txt,0
  printh 0A
  }
  }
  if(pInit.vStep.val==4)
  {
  pInit.vGet.val=4
  pInit.tCommand.txt="GET|detail"
  if(pInit.vBusy.val==0)
  {
  pInit.vSeq.val+=1
  pInit.nAckSeq.val=0
  pInit.vBusy.val=1
  pInit.vRetry.val=0
  pInit.vTask.val=0
  pInit.tReq.txt="CM1|"
  covx pInit.nBoot.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vSeq.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vPage.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.nView.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  pInit.tReq.txt+=pInit.tCommand.txt
  prints pInit.tReq.txt,0
  printh 0A
  }
  }
  if(pInit.vStep.val==5)
  {
  pInit.vGet.val=5
  pInit.tCommand.txt="GET|point"
  pInit.vIndex.val=pInit.vOffset.val+0
  covx pInit.vIndex.val,pInit.tNum.txt,0,0
  pInit.tCommand.txt+="|"
  pInit.tCommand.txt+=pInit.tNum.txt
  if(pInit.vBusy.val==0)
  {
  pInit.vSeq.val+=1
  pInit.nAckSeq.val=0
  pInit.vBusy.val=1
  pInit.vRetry.val=0
  pInit.vTask.val=0
  pInit.tReq.txt="CM1|"
  covx pInit.nBoot.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vSeq.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vPage.val,pInit.tNum.txt,0,0
