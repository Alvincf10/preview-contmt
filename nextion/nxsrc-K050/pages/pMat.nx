on tCem.up:
  if(pInit.vBusy.val==0&&pInit.vStatusReady.val==1)
  {
  if(pInit.vBusy.val==0)
  {
  pInit.tField.txt="cement"
  pInit.tTitle.txt="Cement (kg)"
  pInit.tEdit.txt=tCem.txt
  pInit.vEditKind.val=0
  pInit.vEditPage.val=pInit.vPage.val
  pInit.vMax.val=32
  pInit.vInputMode.val=1
  pInit.vEditView.val=pInit.nView.val
  pInit.vEditBoot.val=pInit.nBoot.val
  page pNumber
  }
  }
  else
  {
  if(pInit.vTask.val==0&&pInit.vTap.val==0&&pInit.nBoot.val>0)
  {
  pInit.vTap.val=1
  pInit.vTapBoot.val=pInit.nBoot.val
  pInit.vTapView.val=pInit.nView.val
  pInit.vTapId.val=0
  }
  if(pInit.vTask.val==1)
  {
  tNotice.txt="Please wait for the current action"
  }
  }

