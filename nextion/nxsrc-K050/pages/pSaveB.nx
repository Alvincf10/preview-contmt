  tNotice.txt="Please wait for the current action"
  }
  }
  }

on pSaveB.loadend:
  if(pInit.vPage.val!=8)
  {
  pInit.vOffset.val=0
  if(pInit.vPage.val==6)
  {
  pInit.vOffset.val=pInit.vSavedOffset.val
  }
  }
  pInit.vPage.val=8
  pInit.vBusy.val=0
  pInit.vRetry.val=0
  pInit.vStep.val=0
