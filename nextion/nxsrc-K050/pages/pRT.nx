on mBack.up:
  if(pInit.vBusy.val==0&&pInit.vStatusReady.val==1)
  {
  if(pInit.vBusy.val==0)
  {
  pInit.vSeq.val+=1
  pInit.nAckSeq.val=0
  pInit.vBusy.val=1
  pInit.vRetry.val=0
  pInit.vTask.val=1
  pInit.tReq.txt="CM1|"
  covx pInit.nBoot.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vSeq.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vPage.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.nView.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  pInit.tReq.txt+="NAV|10"
  prints pInit.tReq.txt,0
  printh 0A
  }
  }
  else
  {
  if(pInit.vTask.val==0&&pInit.vTap.val==0&&pInit.nBoot.val>0)
  {
  pInit.vTap.val=1
  pInit.vTapBoot.val=pInit.nBoot.val
  pInit.vTapView.val=pInit.nView.val
  pInit.vTapId.val=0
  }
  if(pInit.vTask.val==1)
  {
  tNotice.txt="Please wait for the current action"
  }
  }

on mNext.up:
  if(pInit.vBusy.val==0&&pInit.vStatusReady.val==1)
  {
  if(pInit.vBusy.val==0)
  {
  pInit.vSeq.val+=1
  pInit.nAckSeq.val=0
  pInit.vBusy.val=1
  pInit.vRetry.val=0
  pInit.vTask.val=1
  pInit.tReq.txt="CM1|"
  covx pInit.nBoot.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vSeq.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vPage.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.nView.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  pInit.tReq.txt+="RESULT_PREPARE"
  prints pInit.tReq.txt,0
  printh 0A
  }
  }
  else
  {
  if(pInit.vTask.val==0&&pInit.vTap.val==0&&pInit.nBoot.val>0)
  {
  pInit.vTap.val=2
  pInit.vTapBoot.val=pInit.nBoot.val
  pInit.vTapView.val=pInit.nView.val
  pInit.vTapId.val=0
  }
  if(pInit.vTask.val==1)
  {
  tNotice.txt="Please wait for the current action"
  }
  }

on mAddCheck.up:
  if(pInit.vBusy.val==0&&pInit.vStatusReady.val==1)
  {
  if(pInit.vBusy.val==0)
  {
  pInit.vSeq.val+=1
  pInit.nAckSeq.val=0
  pInit.vBusy.val=1
  pInit.vRetry.val=0
  pInit.vTask.val=1
  pInit.tReq.txt="CM1|"
  covx pInit.nBoot.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vSeq.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vPage.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.nView.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  pInit.tReq.txt+="CHECK_ADD"
  prints pInit.tReq.txt,0
  printh 0A
  }
  }
  else
  {
  if(pInit.vTask.val==0&&pInit.vTap.val==0&&pInit.nBoot.val>0)
  {
  pInit.vTap.val=3
  pInit.vTapBoot.val=pInit.nBoot.val
  pInit.vTapView.val=pInit.nView.val
  pInit.vTapId.val=0
  }
  if(pInit.vTask.val==1)
  {
  tNotice.txt="Please wait for the current action"
  }
  }

on mPoints.up:
  if(pInit.vBusy.val==0&&pInit.vStatusReady.val==1)
  {
  pInit.vOffset.val=0
  page pPoints
  }
  else
  {
  if(pInit.vTask.val==0&&pInit.vTap.val==0&&pInit.nBoot.val>0)
  {
  pInit.vTap.val=4
  pInit.vTapBoot.val=pInit.nBoot.val
  pInit.vTapView.val=pInit.nView.val
  pInit.vTapId.val=0
  }
  if(pInit.vTask.val==1)
  {
  tNotice.txt="Please wait for the current action"
  }
  }

on pRT.loadend:
  if(pInit.vPage.val!=11)
  {
  pInit.vOffset.val=0

  }
  pInit.vPage.val=11
  pInit.vBusy.val=0
  pInit.vRetry.val=0
  pInit.vStep.val=0
  pInit.vPoll.val=0
  pInit.vTap.val=0
  pInit.vStatusReady.val=0
  pInit.vTask.val=0
  pInit.tMsg.txt=""
  tClock.txt="--:--"
  tBatt.txt="--%"
  tBatt.pco=65535
  pInit.vTemp.val=0
  picq 367,82,22,22,18
  if(pInit.vTemp.val>0)
  {
  fill 371,90,pInit.vTemp.val,6,tBatt.pco
  }

on tmPoll.timer:
  if(pInit.vBusy.val==1)
  {
  if(pInit.nAckSeq.val==pInit.vSeq.val)
  {
  pInit.vBusy.val=0
  pInit.vRetry.val=0
  if(pInit.nAckCode.val==4||pInit.nAckCode.val==8)
  {
  pInit.nBoot.val=0
  pInit.vStep.val=0
  pInit.vTap.val=0
  pInit.vStatusReady.val=0
  }else
  {
  if(pInit.vTask.val==0)
  {
  if(pInit.vGet.val==1)
  {
  if(pInit.nAckCode.val==0)
  {
  pInit.tStatus.txt=pInit.tData.txt
  spstr pInit.tData.txt,pInit.tTime.txt,"|",1
  tClock.txt="--:--"
  if(pInit.tTime.txt!="")
  {
  substr pInit.tTime.txt,tClock.txt,0,5
  }
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",3
  tBatt.txt="--%"
  tBatt.pco=65535
  pInit.vTemp.val=0
  if(pInit.tSplit.txt!="")
  {
  covx pInit.tSplit.txt,pInit.vTemp.val,0,0
  tBatt.txt=pInit.tSplit.txt
  tBatt.txt+="%"
  if(pInit.vTemp.val<=40)
  {
  tBatt.pco=65132
  }
  if(pInit.vTemp.val<=20)
  {
  tBatt.pco=64329
  }
  pInit.vTemp.val*=11
  pInit.vTemp.val+=50
  pInit.vTemp.val/=100
  }
  picq 367,82,22,22,18
  if(pInit.vTemp.val>0)
  {
  fill 371,90,pInit.vTemp.val,6,tBatt.pco
  }
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",4
  covx pInit.tSplit.txt,pInit.vStorage.val,0,0
  spstr pInit.tData.txt,pInit.tDate.txt,"|",0
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",14
  covx pInit.tSplit.txt,pInit.vMask.val,0,0
  pInit.vSensors.val=0
  pInit.vCount.val=pInit.vMask.val
  if(pInit.vCount.val>=4)
  {
  pInit.vSensors.val+=1
  pInit.vCount.val-=4
  }
  if(pInit.vCount.val>=2)
  {
  pInit.vSensors.val+=1
  pInit.vCount.val-=2
  }
  if(pInit.vCount.val>=1)
  {
  pInit.vSensors.val+=1
  }
  spstr pInit.tData.txt,tS1.txt,"|",10
  if(tS1.txt!="")
  {
  pInit.tSplit.txt=""
  spstr tS1.txt,pInit.tSplit.txt,".",1
  if(pInit.tSplit.txt=="")
  {
  tS1.txt+=".0"
  }
  tS1.txt+=" °C"
  }
  if(tS1.txt=="")
  {
  tS1.txt="--"
  }
  spstr pInit.tData.txt,tS2.txt,"|",11
  if(tS2.txt!="")
  {
  pInit.tSplit.txt=""
  spstr tS2.txt,pInit.tSplit.txt,".",1
  if(pInit.tSplit.txt=="")
  {
  tS2.txt+=".0"
  }
  tS2.txt+=" °C"
  }
  if(tS2.txt=="")
  {
  tS2.txt="--"
  }
  spstr pInit.tData.txt,tS3.txt,"|",12
  if(tS3.txt!="")
  {
  pInit.tSplit.txt=""
  spstr tS3.txt,pInit.tSplit.txt,".",1
  if(pInit.tSplit.txt=="")
  {
  tS3.txt+=".0"
  }
  tS3.txt+=" °C"
  }
  if(tS3.txt=="")
  {
  tS3.txt="--"
  }
  spstr pInit.tData.txt,tAvg.txt,"|",13
  if(tAvg.txt!="")
  {
  pInit.tSplit.txt=""
  spstr tAvg.txt,pInit.tSplit.txt,".",1
  if(pInit.tSplit.txt=="")
  {
  tAvg.txt+=".0"
  }
  tAvg.txt+=" °C"
  }
  if(tAvg.txt=="")
  {
  tAvg.txt="--"
  }
  tNowD.txt=pInit.tDate.txt
  strlen tNowD.txt,pInit.vTemp.val
  if(pInit.vTemp.val==10)
  {
  spstr tNowD.txt,pInit.tNum.txt,"-",2
  spstr tNowD.txt,pInit.tSplit.txt,"-",1
  pInit.tNum.txt+="-"
  pInit.tNum.txt+=pInit.tSplit.txt
  spstr tNowD.txt,pInit.tSplit.txt,"-",0
  pInit.tNum.txt+="-"
  pInit.tNum.txt+=pInit.tSplit.txt
  tNowD.txt=pInit.tNum.txt
  }
  tNowT.txt=pInit.tTime.txt
  tNowTemp.txt=tAvg.txt
  pInit.vStatusReady.val=1
  }
  }
  if(pInit.vGet.val==2)
  {
  if(pInit.nAckCode.val==0)
  {
  spstr pInit.tData.txt,tBase.txt,"|",1
  spstr pInit.tData.txt,tTarget.txt,"|",2
  if(tTarget.txt!="")
  {
  tTarget.txt+=" MPa"
  }
  spstr pInit.tData.txt,tDatum.txt,"|",3
  if(tDatum.txt!="")
  {
  tDatum.txt+=" °C"
  }
  }
  }
  if(pInit.vGet.val==3)
  {
  if(pInit.nAckCode.val==0)
  {
  spstr pInit.tData.txt,tPDate.txt,"|",4
  strlen tPDate.txt,pInit.vTemp.val
  if(pInit.vTemp.val==10)
  {
  spstr tPDate.txt,pInit.tNum.txt,"-",2
  spstr tPDate.txt,pInit.tSplit.txt,"-",1
  pInit.tNum.txt+="-"
  pInit.tNum.txt+=pInit.tSplit.txt
  spstr tPDate.txt,pInit.tSplit.txt,"-",0
  pInit.tNum.txt+="-"
  pInit.tNum.txt+=pInit.tSplit.txt
  tPDate.txt=pInit.tNum.txt
  }
  spstr pInit.tData.txt,tPour.txt,"|",5
  spstr pInit.tData.txt,tInitTemp.txt,"|",8
  spstr pInit.tData.txt,tElapsed.txt,"|",9
  spstr pInit.tData.txt,tM.txt,"|",10
  spstr pInit.tData.txt,tFc.txt,"|",11
  spstr pInit.tData.txt,tPct.txt,"|",12
  if(tFc.txt!="")
  {
  pInit.tSplit.txt=""
  spstr tFc.txt,pInit.tSplit.txt,".",1
  if(pInit.tSplit.txt=="")
  {
  tFc.txt+=".0"
  }
  tFc.txt+=" MPa"
  }
  if(tPct.txt!="")
  {
  tPct.txt+="%"
  }
  if(tM.txt!="")
  {
  tM.txt+=" °C·h"
  }
  if(tInitTemp.txt!="")
  {
  pInit.tSplit.txt=""
  spstr tInitTemp.txt,pInit.tSplit.txt,".",1
  if(pInit.tSplit.txt=="")
  {
  tInitTemp.txt+=".0"
  }
  tInitTemp.txt+=" °C"
  }
  pInit.vRevision.val=pInit.nAckValue.val
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",2
  covx pInit.tSplit.txt,pInit.vTotal.val,0,0
  }
  }
  pInit.vStep.val+=1
  }else
  {
  if(pInit.nAckCode.val==13)
  {
  pInit.vToken.val=pInit.nAckValue.val
  page pConfirm
  }else
  {
  if(pInit.nAckCode.val!=0)
  {
  pInit.tMsg.txt="ConMT error "
  covx pInit.nAckCode.val,pInit.tNum.txt,0,0
  pInit.tMsg.txt+=pInit.tNum.txt
  if(pInit.nAckCode.val==1)
  {
  pInit.tMsg.txt="Invalid input. Check the field format."
  }
  if(pInit.nAckCode.val==2)
  {
  pInit.tMsg.txt="Complete the required fields"
  }
  if(pInit.nAckCode.val==3)
  {
  pInit.tMsg.txt="Complete the previous step first"
  if(pInit.vPage.val==8||pInit.vPage.val==10)
  {
  pInit.tMsg.txt="Select a baseline first"
  }
  }
  if(pInit.nAckCode.val==15)
  {
  pInit.tMsg.txt="This item is no longer available"
  }
  if(pInit.nAckCode.val==6)
  {
  pInit.tMsg.txt="Check the microSD card"
  }
  if(pInit.nAckCode.val==9)
  {
  pInit.tMsg.txt="Connect a temperature probe"
  }
  if(pInit.nAckCode.val==10)
  {
  pInit.tMsg.txt="Set date/time before measurement"
  }
  if(pInit.nAckCode.val==11)
  {
  pInit.tMsg.txt="Enter at least two valid lab pairs"
  }
  if(pInit.nAckCode.val==12)
  {
  pInit.tMsg.txt="Add a later checkpoint before SAVE"
  }
  }else
  {
  pInit.tMsg.txt=""
  spstr pInit.tReq.txt,pInit.tSplit.txt,"|",5
  if(pInit.tSplit.txt=="CHECK_ADD")
  {
  pInit.tMsg.txt="Day saved. Tap REAL TIME MONITORING."
  }

  }
  pInit.vStep.val=1
  }
  }
  }
  }
  else
  {
  pInit.vRetry.val+=1
  if(pInit.vRetry.val==15)
  {
  prints pInit.tReq.txt,0
  printh 0A
  }
  if(pInit.vRetry.val>=30)
  {
  pInit.vBusy.val=0
  pInit.nBoot.val=0
  pInit.vStep.val=0
  pInit.vTap.val=0
  pInit.vStatusReady.val=0
  pInit.tMsg.txt="No answer from MCU"
  tClock.txt="--:--"
  tBatt.txt="--%"
  tBatt.pco=65535
  pInit.vTemp.val=0
  picq 367,82,22,22,18
  if(pInit.vTemp.val>0)
  {
  fill 371,90,pInit.vTemp.val,6,tBatt.pco
  }
  }
  }
  }
  if(tNotice.txt!=pInit.tMsg.txt)
  {
  tNotice.txt=pInit.tMsg.txt
  }
  if(dp==11&&pInit.vBusy.val==0&&pInit.vTap.val>0&&pInit.vStatusReady.val==1)
  {
  pInit.vDispatch.val=pInit.vTap.val
  pInit.vTap.val=0
  if(pInit.vTapView.val==pInit.nView.val&&pInit.vTapBoot.val==pInit.nBoot.val)
  {
  if(pInit.vDispatch.val==1)
  {
  click mBack,0
  }
  if(pInit.vDispatch.val==2)
  {
  click mNext,0
  }
  if(pInit.vDispatch.val==3)
  {
  click mAddCheck,0
  }
  if(pInit.vDispatch.val==4)
  {
  click mPoints,0
  }
  }
  else
  {
  pInit.tMsg.txt="View updated. Tap again."
  }
  }
  if(pInit.vBusy.val==0&&dp==11)
  {
  if(pInit.vStep.val==0)
  {
  pInit.vGet.val=0
  if(pInit.vBusy.val==0)
  {
  pInit.vSeq.val+=1
  pInit.nAckSeq.val=0
  pInit.vBusy.val=1
  pInit.vRetry.val=0
  pInit.vTask.val=0
  pInit.tReq.txt="CM1|"
  covx pInit.nBoot.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vSeq.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vPage.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.nView.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  pInit.tReq.txt+="PAGE_READY"
  prints pInit.tReq.txt,0
  printh 0A
  }
  }
  if(pInit.vStep.val==1)
  {
  pInit.vGet.val=1
  pInit.tCommand.txt="GET|status"
  if(pInit.vBusy.val==0)
  {
  pInit.vSeq.val+=1
  pInit.nAckSeq.val=0
  pInit.vBusy.val=1
  pInit.vRetry.val=0
  pInit.vTask.val=0
  pInit.tReq.txt="CM1|"
  covx pInit.nBoot.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vSeq.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vPage.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.nView.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  pInit.tReq.txt+=pInit.tCommand.txt
  prints pInit.tReq.txt,0
  printh 0A
  }
  }
  if(pInit.vStep.val==2)
  {
  pInit.vGet.val=2
  pInit.tCommand.txt="GET|baseline"
  if(pInit.vBusy.val==0)
  {
  pInit.vSeq.val+=1
  pInit.nAckSeq.val=0
  pInit.vBusy.val=1
  pInit.vRetry.val=0
  pInit.vTask.val=0
  pInit.tReq.txt="CM1|"
  covx pInit.nBoot.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vSeq.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vPage.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.nView.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  pInit.tReq.txt+=pInit.tCommand.txt
  prints pInit.tReq.txt,0
  printh 0A
  }
  }
  if(pInit.vStep.val==3)
  {
  pInit.vGet.val=3
  pInit.tCommand.txt="GET|run"
  if(pInit.vBusy.val==0)
  {
  pInit.vSeq.val+=1
  pInit.nAckSeq.val=0
  pInit.vBusy.val=1
  pInit.vRetry.val=0
  pInit.vTask.val=0
  pInit.tReq.txt="CM1|"
  covx pInit.nBoot.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vSeq.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vPage.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.nView.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  pInit.tReq.txt+=pInit.tCommand.txt
  prints pInit.tReq.txt,0
  printh 0A
  }
  }
  if(pInit.vStep.val>3)
  {
  pInit.vPoll.val+=1
  if(pInit.vPoll.val>=5)
  {
  pInit.vPoll.val=0
  pInit.vStep.val=1
  }
  }
  }
