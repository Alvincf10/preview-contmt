on mDetail.up:
  if(pInit.vListReady.val==1)
  {
  if(pInit.vBusy.val==0&&pInit.vStatusReady.val==1)
  {
  if(vHist0.val>0)
  {
  pInit.vHistoryOffset.val=pInit.vOffset.val
  pInit.tCommand.txt="HISTORY_PICK|"
  pInit.vTemp.val=pInit.vOffset.val+0
  covx pInit.vTemp.val,pInit.tNum.txt,0,0
  pInit.tCommand.txt+=pInit.tNum.txt
  if(pInit.vBusy.val==0)
