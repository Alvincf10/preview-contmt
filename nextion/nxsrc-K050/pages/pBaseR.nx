on pBaseR.loadend:
  if(pInit.vPage.val!=7)
  {
  pInit.vOffset.val=0
  }
  pInit.vPage.val=7
  pInit.vBusy.val=0
  pInit.vRetry.val=0
  pInit.vStep.val=0
  pInit.vPoll.val=0
  pInit.tMsg.txt=""

on mBack.down:
  if(pInit.vBusy.val==0)
  {
  pInit.vSeq.val+=1
  pInit.nAckSeq.val=0
  pInit.vBusy.val=1
  pInit.vRetry.val=0
  pInit.vTask.val=1
  pInit.tReq.txt="CM1|"
  covx pInit.nBoot.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vSeq.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vPage.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.nView.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  pInit.tReq.txt+="NAV|6"
  prints pInit.tReq.txt,0
  printh 0A
  }

on tmPoll.timer:
  if(pInit.vBusy.val==1)
  {
  if(pInit.nAckSeq.val==pInit.vSeq.val)
  {
  pInit.vBusy.val=0
  pInit.vRetry.val=0
  if(pInit.nAckCode.val==4||pInit.nAckCode.val==8)
  {
  pInit.nBoot.val=0
  pInit.vStep.val=0
  }else
  {
  if(pInit.vTask.val==0)
  {
  if(pInit.vGet.val==1)
  {
  if(pInit.nAckCode.val==0)
  {
  pInit.tStatus.txt=pInit.tData.txt
  spstr pInit.tData.txt,tClock.txt,"|",1
  spstr pInit.tData.txt,tBatt.txt,"|",3
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",4
  covx pInit.tSplit.txt,pInit.vStorage.val,0,0
  spstr pInit.tData.txt,pInit.tDate.txt,"|",0
  spstr pInit.tData.txt,pInit.tTime.txt,"|",1
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",14
  covx pInit.tSplit.txt,pInit.vMask.val,0,0
  pInit.vSensors.val=0
  pInit.vCount.val=pInit.vMask.val
  if(pInit.vCount.val>=4)
  {
  pInit.vSensors.val+=1
  pInit.vCount.val-=4
  }
  if(pInit.vCount.val>=2)
  {
  pInit.vSensors.val+=1
  pInit.vCount.val-=2
  }
  if(pInit.vCount.val>=1)
  {
  pInit.vSensors.val+=1
  }
  }
  }
  if(pInit.vGet.val==2)
  {
  if(pInit.nAckCode.val==0)
  {
  spstr pInit.tData.txt,tName.txt,"|",1
  spstr pInit.tData.txt,tTarget.txt,"|",2
  spstr pInit.tData.txt,tDatum.txt,"|",3
  pInit.vRevision.val=pInit.nAckValue.val
  }
  }
  if(pInit.vGet.val==3)
  {
  if(pInit.nAckCode.val==0)
  {
  spstr pInit.tData.txt,tCem.txt,"|",0
  spstr pInit.tData.txt,tWat.txt,"|",1
  spstr pInit.tData.txt,tCoa.txt,"|",2
  spstr pInit.tData.txt,tFin.txt,"|",3
  spstr pInit.tData.txt,tRetP.txt,"|",4
  spstr pInit.tData.txt,tAccP.txt,"|",5
  spstr pInit.tData.txt,tFlyP.txt,"|",6
  spstr pInit.tData.txt,tRetB.txt,"|",7
  spstr pInit.tData.txt,tAccB.txt,"|",8
  spstr pInit.tData.txt,tFlyB.txt,"|",9
  spstr pInit.tData.txt,tWC.txt,"|",10
  }
  }
  if(pInit.vGet.val==4)
  {
  if(pInit.nAckCode.val==0)
  {
  spstr pInit.tData.txt,tA.txt,"|",0
  spstr pInit.tData.txt,tB.txt,"|",1
  spstr pInit.tData.txt,tR2.txt,"|",2
  spstr pInit.tData.txt,tCount.txt,"|",3
  spstr pInit.tData.txt,tOp.txt,"|",6
  spstr pInit.tData.txt,tProj.txt,"|",7
  spstr pInit.tData.txt,tDate.txt,"|",8
  }
  }
  pInit.vStep.val+=1
  }else
  {
  if(pInit.nAckCode.val==13)
  {
  pInit.vToken.val=pInit.nAckValue.val
  page pConfirm
  }else
  {
  if(pInit.nAckCode.val!=0)
  {
  pInit.tMsg.txt="ConMT error "
  covx pInit.nAckCode.val,pInit.tNum.txt,0,0
  pInit.tMsg.txt+=pInit.tNum.txt
  if(pInit.nAckCode.val==1)
  {
  pInit.tMsg.txt="Invalid input. Check the field format."
  }
  if(pInit.nAckCode.val==2)
  {
  pInit.tMsg.txt="Complete the required fields"
  }
  if(pInit.nAckCode.val==6)
  {
  pInit.tMsg.txt="Check the microSD card"
  }
  if(pInit.nAckCode.val==9)
  {
  pInit.tMsg.txt="Connect a temperature probe"
  }
  if(pInit.nAckCode.val==10)
  {
  pInit.tMsg.txt="Set date/time before measurement"
  }
  if(pInit.nAckCode.val==11)
  {
  pInit.tMsg.txt="Enter at least two valid lab pairs"
  }
  if(pInit.nAckCode.val==12)
  {
  pInit.tMsg.txt="Add a later checkpoint before SAVE"
  }
  }else
  {
  pInit.tMsg.txt=""
  }
  pInit.vStep.val=1
  }
  }
  }
  }
  else
  {
  pInit.vRetry.val+=1
  if(pInit.vRetry.val==15)
  {
  prints pInit.tReq.txt,0
  printh 0A
  }
  if(pInit.vRetry.val>=30)
  {
  pInit.vBusy.val=0
  pInit.nBoot.val=0
  pInit.vStep.val=0
  pInit.tMsg.txt="No answer from MCU"
  }
  }
  }
  if(pInit.vBusy.val==0&&dp==pInit.vPage.val)
  {
  if(pInit.vStep.val==0)
  {
  pInit.vGet.val=0
  if(pInit.vBusy.val==0)
  {
  pInit.vSeq.val+=1
  pInit.nAckSeq.val=0
  pInit.vBusy.val=1
  pInit.vRetry.val=0
  pInit.vTask.val=0
  pInit.tReq.txt="CM1|"
  covx pInit.nBoot.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vSeq.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vPage.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.nView.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  pInit.tReq.txt+="PAGE_READY"
  prints pInit.tReq.txt,0
  printh 0A
  }
  }
  if(pInit.vStep.val==1)
  {
  pInit.vGet.val=1
  pInit.tCommand.txt="GET|status"
  if(pInit.vBusy.val==0)
  {
  pInit.vSeq.val+=1
  pInit.nAckSeq.val=0
  pInit.vBusy.val=1
  pInit.vRetry.val=0
  pInit.vTask.val=0
  pInit.tReq.txt="CM1|"
  covx pInit.nBoot.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vSeq.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vPage.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.nView.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  pInit.tReq.txt+=pInit.tCommand.txt
  prints pInit.tReq.txt,0
  printh 0A
  }
  }
  if(pInit.vStep.val==2)
  {
  pInit.vGet.val=2
  pInit.tCommand.txt="GET|baseline"
  if(pInit.vBusy.val==0)
  {
  pInit.vSeq.val+=1
  pInit.nAckSeq.val=0
  pInit.vBusy.val=1
  pInit.vRetry.val=0
  pInit.vTask.val=0
  pInit.tReq.txt="CM1|"
  covx pInit.nBoot.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vSeq.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vPage.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.nView.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  pInit.tReq.txt+=pInit.tCommand.txt
  prints pInit.tReq.txt,0
  printh 0A
  }
  }
  if(pInit.vStep.val==3)
  {
  pInit.vGet.val=3
  pInit.tCommand.txt="GET|mix"
  if(pInit.vBusy.val==0)
  {
  pInit.vSeq.val+=1
  pInit.nAckSeq.val=0
  pInit.vBusy.val=1
  pInit.vRetry.val=0
  pInit.vTask.val=0
  pInit.tReq.txt="CM1|"
  covx pInit.nBoot.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vSeq.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vPage.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.nView.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  pInit.tReq.txt+=pInit.tCommand.txt
  prints pInit.tReq.txt,0
  printh 0A
  }
  }
  if(pInit.vStep.val==4)
  {
  pInit.vGet.val=4
  pInit.tCommand.txt="GET|model"
  if(pInit.vBusy.val==0)
  {
  pInit.vSeq.val+=1
  pInit.nAckSeq.val=0
  pInit.vBusy.val=1
  pInit.vRetry.val=0
  pInit.vTask.val=0
  pInit.tReq.txt="CM1|"
  covx pInit.nBoot.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vSeq.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vPage.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.nView.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  pInit.tReq.txt+=pInit.tCommand.txt
  prints pInit.tReq.txt,0
  printh 0A
  }
  }
  if(pInit.vStep.val>4)
  {
  pInit.vPoll.val+=1
  if(pInit.vPoll.val>=5)
  {
  pInit.vPoll.val=0
  pInit.vStep.val=1
  }
  }
  }

on mSave.down:
  pInit.tCommand.txt="BASE_SAVE|"
  covx pInit.vRevision.val,pInit.tNum.txt,0,0
  pInit.tCommand.txt+=pInit.tNum.txt
  if(pInit.vBusy.val==0)
  {
  pInit.vSeq.val+=1
  pInit.nAckSeq.val=0
  pInit.vBusy.val=1
  pInit.vRetry.val=0
  pInit.vTask.val=1
  pInit.tReq.txt="CM1|"
  covx pInit.nBoot.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vSeq.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vPage.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.nView.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  pInit.tReq.txt+=pInit.tCommand.txt
  prints pInit.tReq.txt,0
  printh 0A
  }

on mCurve.up:
  if(pInit.vBusy.val==0)
  {
  page pChart
  }
