on pClock.loadend:
  tDate.txt=pInit.tClockDate.txt
  strlen tDate.txt,pInit.vTemp.val
  if(pInit.vTemp.val==10)
  {
  spstr tDate.txt,pInit.tNum.txt,"-",2
  spstr tDate.txt,pInit.tSplit.txt,"-",1
  pInit.tNum.txt+="-"
  pInit.tNum.txt+=pInit.tSplit.txt
  spstr tDate.txt,pInit.tSplit.txt,"-",0
  pInit.tNum.txt+="-"
  pInit.tNum.txt+=pInit.tSplit.txt
  tDate.txt=pInit.tNum.txt
  }
  tTime.txt=pInit.tClockTime.txt
  tError.txt=""

on tDate.up:
  if(pInit.vBusy.val==0)
  {
  pInit.tField.txt="date"
  pInit.tTitle.txt="Date DD-MM-YYYY"
  pInit.tEdit.txt=tDate.txt
  pInit.vEditKind.val=2
  pInit.vEditPage.val=19
  pInit.vMax.val=10
  pInit.vInputMode.val=3
  pInit.vEditView.val=pInit.nView.val
  pInit.vEditBoot.val=pInit.nBoot.val
  page pNumber
  }

on tTime.up:
  if(pInit.vBusy.val==0)
  {
  pInit.tField.txt="time"
  pInit.tTitle.txt="Time HH:MM:SS"
  pInit.tEdit.txt=tTime.txt
  pInit.vEditKind.val=2
  pInit.vEditPage.val=19
  pInit.vMax.val=8
  pInit.vInputMode.val=4
  pInit.vEditView.val=pInit.nView.val
  pInit.vEditBoot.val=pInit.nBoot.val
  page pNumber
  }

on mCancel.up:
  if(pInit.vBusy.val==0)
  {
  page pInit.vPage.val
  }

on mSave.up:
  pInit.tCommand.txt="CLOCK_SET|"
  pInit.tCommand.txt+=pInit.tClockDate.txt
  pInit.tCommand.txt+="|"
  pInit.tCommand.txt+=tTime.txt
  if(pInit.vBusy.val==0)
  {
  pInit.vSeq.val+=1
  pInit.nAckSeq.val=0
  pInit.vBusy.val=1
  pInit.vRetry.val=0
  pInit.vTask.val=1
  pInit.tReq.txt="CM1|"
  covx pInit.nBoot.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vSeq.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vPage.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.nView.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  pInit.tReq.txt+=pInit.tCommand.txt
  prints pInit.tReq.txt,0
  printh 0A
  }

on tmClock.timer:
  if(pInit.vBusy.val==1)
  {
  if(pInit.nAckSeq.val==pInit.vSeq.val)
  {
  pInit.vBusy.val=0
  if(pInit.nAckCode.val==0)
  {
  page pInit.vPage.val
  }else
  {
  pInit.tMsg.txt="ConMT error "
  covx pInit.nAckCode.val,pInit.tNum.txt,0,0
  pInit.tMsg.txt+=pInit.tNum.txt
  if(pInit.nAckCode.val==1)
  {
  pInit.tMsg.txt="Invalid input. Check the field format."
  }
  if(pInit.nAckCode.val==2)
  {
  pInit.tMsg.txt="Complete the required fields"
  }
  if(pInit.nAckCode.val==3)
  {
  pInit.tMsg.txt="Complete the previous step first"
  if(pInit.vPage.val==8||pInit.vPage.val==10)
  {
  pInit.tMsg.txt="Select a baseline first"
  }
  }
  if(pInit.nAckCode.val==15)
  {
  pInit.tMsg.txt="This item is no longer available"
  }
  if(pInit.nAckCode.val==6)
  {
  pInit.tMsg.txt="Check the microSD card"
  }
  if(pInit.nAckCode.val==9)
  {
  pInit.tMsg.txt="Connect a temperature probe"
  }
  if(pInit.nAckCode.val==10)
  {
  pInit.tMsg.txt="Set date/time before measurement"
  }
  if(pInit.nAckCode.val==11)
  {
  pInit.tMsg.txt="Enter at least two valid lab pairs"
  }
  if(pInit.nAckCode.val==12)
  {
  pInit.tMsg.txt="Add a later checkpoint before SAVE"
  }
  if(pInit.nAckCode.val==6)
  {
  pInit.tMsg.txt="Insert microSD to set the device clock"
  }
  tError.txt=pInit.tMsg.txt
  }
  }
  else
  {
  pInit.vRetry.val+=1
  if(pInit.vRetry.val==15)
  {
  prints pInit.tReq.txt,0
  printh 0A
  }
  if(pInit.vRetry.val>=30)
  {
  pInit.vBusy.val=0
  tError.txt="No answer. Return and reconnect."
  }
  }
  }
