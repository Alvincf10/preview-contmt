  pInit.vMax.val=24
  pInit.vEditRow.val=pInit.vOffset.val+10
  page pEdit
  }

on tDay11.up:
  if(pInit.vBusy.val==0)
  {
  pInit.tField.txt="day"
  pInit.tTitle.txt="day"
  pInit.tEdit.txt=tDay11.txt
  pInit.vEditKind.val=1
  pInit.vEditPage.val=pInit.vPage.val
  pInit.vMax.val=24
  pInit.vEditRow.val=pInit.vOffset.val+11
  page pEdit
  }

