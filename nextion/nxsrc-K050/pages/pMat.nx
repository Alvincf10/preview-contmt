on mBack.up:
  if(pInit.vBusy.val==0&&pInit.vStatusReady.val==1)
  {
  if(pInit.vBusy.val==0)
  {
  pInit.vSeq.val+=1
  pInit.nAckSeq.val=0
  pInit.vBusy.val=1
  pInit.vRetry.val=0
  pInit.vTask.val=1
  pInit.tReq.txt="CM1|"
  covx pInit.nBoot.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vSeq.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vPage.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.nView.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  pInit.tReq.txt+="NAV|4"
  prints pInit.tReq.txt,0
  printh 0A
  }
  }
  else
  {
  if(pInit.vTask.val==0&&pInit.vTap.val==0&&pInit.nBoot.val>0)
  {
  pInit.vTap.val=11
  pInit.vTapBoot.val=pInit.nBoot.val
  pInit.vTapView.val=pInit.nView.val
  pInit.vTapId.val=0
  }
  if(pInit.vTask.val==1)
  {
  tNotice.txt="Please wait for the current action"
  }
  }

on mNext.up:
  if(pInit.vBusy.val==0&&pInit.vStatusReady.val==1)
