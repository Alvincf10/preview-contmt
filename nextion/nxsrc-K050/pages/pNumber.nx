on kN1.up:
  if(pInit.vBusy.val==0)
  {
  if(pInit.vInputMode.val==5)
  {
  tInput.txt=kN1.txt
  }
  else
  {
  strlen tInput.txt,vLen.val
  if(vLen.val<pInit.vMax.val)
  {
  if(vLen.val==2||vLen.val==5)
  {
  if(pInit.vInputMode.val==3)
  {
  tInput.txt+="-"
  }
  if(pInit.vInputMode.val==4)
  {
  tInput.txt+=":"
  }
  }
  tInput.txt+="1"
  }
  }
  tError.txt=""
  }

