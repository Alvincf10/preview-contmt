  }

on mNextRows.up:
  if(pInit.vBusy.val==0)
  {
  pInit.vOffset.val+=12
  pInit.vStep.val=1
  }

on mPrevRows.up:
  if(pInit.vBusy.val==0&&pInit.vOffset.val>=12)
  {
  pInit.vOffset.val-=12
  pInit.vStep.val=1
  }
