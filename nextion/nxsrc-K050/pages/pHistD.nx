on mBack.up:
  if(pInit.vBusy.val==0&&pInit.vStatusReady.val==1)
  {
  if(pInit.vBusy.val==0)
  {
  pInit.vSeq.val+=1
  pInit.nAckSeq.val=0
  pInit.vBusy.val=1
  pInit.vRetry.val=0
  pInit.vTask.val=1
  pInit.tReq.txt="CM1|"
  covx pInit.nBoot.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vSeq.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vPage.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.nView.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  pInit.tReq.txt+="NAV|13"
  prints pInit.tReq.txt,0
  printh 0A
  }
  }
  else
  {
  if(pInit.vTask.val==0&&pInit.vTap.val==0&&pInit.nBoot.val>0)
  {
  pInit.vTap.val=1
  pInit.vTapBoot.val=pInit.nBoot.val
  pInit.vTapView.val=pInit.nView.val
  pInit.vTapId.val=0
  }
  if(pInit.vTask.val==1)
  {
  tNotice.txt="Please wait for the current action"
  }
  }

on pHistD.loadend:
  if(pInit.vPage.val!=14)
  {
  pInit.vOffset.val=0

  }
  pInit.vPage.val=14
  pInit.vBusy.val=0
  pInit.vRetry.val=0
  pInit.vStep.val=0
  pInit.vPoll.val=0
  pInit.vTap.val=0
  pInit.vStatusReady.val=0
  pInit.vTask.val=0
  pInit.tMsg.txt=""
  tClock.txt="--:--"
  tBatt.txt="--%"
  tBatt.pco=65535
  pInit.vTemp.val=0
  picq 367,82,22,22,23
  if(pInit.vTemp.val>0)
  {
  fill 371,90,pInit.vTemp.val,6,tBatt.pco
  }
  tLog0.txt=""
  tsw tLog0,0
  vis tLog0,0
  picq 77,460,326,42,23
  tLog1.txt=""
  tsw tLog1,0
  vis tLog1,0
  picq 77,508,326,42,23
  tLog2.txt=""
  tsw tLog2,0
  vis tLog2,0
  picq 77,556,326,42,23
  tLog3.txt=""
  tsw tLog3,0
  vis tLog3,0
  picq 77,604,326,42,23
  tLog4.txt=""
  tsw tLog4,0
  vis tLog4,0
  picq 77,652,326,42,23
  tmDrag.en=0
  vBlockTap.val=0
  pInit.vTouchPhase.val=0
  pInit.vListBase.val=pInit.vOffset.val
  pInit.vListShift.val=0
  pInit.vListReuse.val=0
  pInit.vListDirty.val=1
  pInit.vListReady.val=0

on tcList.down:
  if(pInit.vTouchPhase.val==2)
  {
  pInit.vTap.val=0
  }
  tmDrag.en=0
  pInit.vTouchPhase.val=0
  vBlockTap.val=0
  vStartX.val=tch0
  vStartY.val=tch1
  if(vStartX.val>=77&&vStartX.val<411&&vStartY.val>=460&&vStartY.val<694)
  {
  pInit.vTouchPhase.val=1
  vPriorX.val=tch2
  vPriorY.val=tch3
  vDragX.val=0
  vDragY.val=0
  tmDrag.en=1
  if(pInit.vListReady.val==0||pInit.vListShift.val!=0)
  {
  vBlockTap.val=1
  }
  }

on tcList.up:
  if(pInit.vTouchPhase.val==1)
  {
  pInit.vTouchPhase.val=2
  }

on tmDrag.timer:
  if(pInit.vTouchPhase.val==1)
  {
  if(tch0!=0||tch1!=0)
  {
  vDragX.val=tch0-vStartX.val
  if(vDragX.val<0)
  {
  vDragX.val*=-1
  }
  vDragY.val=vStartY.val-tch1
  if(vDragX.val>=16||vDragY.val>=16||vDragY.val<=-16)
  {
  vBlockTap.val=1
  }
  }
  }
  else
  {
  tmDrag.en=0
  pInit.vTouchPhase.val=0
  if(tch0==0&&tch1==0)
  {
  if(tch2!=vPriorX.val||tch3!=vPriorY.val)
  {
  if(tch2>=0&&tch2<480&&tch3>=0&&tch3<800)
  {
  vDragX.val=tch2-vStartX.val
  if(vDragX.val<0)
  {
  vDragX.val*=-1
  }
  vDragY.val=vStartY.val-tch3
  if(vDragX.val>=16||vDragY.val>=16||vDragY.val<=-16)
  {
  vBlockTap.val=1
  }
  }
  }
  pInit.vTemp.val=vDragY.val
  if(pInit.vTemp.val<0)
  {
  pInit.vTemp.val*=-1
  }
  if(pInit.vTemp.val>=22&&pInit.vTemp.val>vDragX.val)
  {
  pInit.vTemp.val+=24
  pInit.vTemp.val/=48
  if(pInit.vTemp.val<1)
  {
  pInit.vTemp.val=1
  }
  if(vDragY.val>0)
  {
  pInit.vListShift.val+=pInit.vTemp.val
  }else
  {
  pInit.vListShift.val-=pInit.vTemp.val
  }
  vBlockTap.val=1
  }
  }
  else
  {
  vBlockTap.val=1
  }
  if(vBlockTap.val==1)
  {
  pInit.vTap.val=0
  }
  }

on tmPoll.timer:
  if(pInit.vBusy.val==1)
  {
  if(pInit.nAckSeq.val==pInit.vSeq.val)
  {
  pInit.vBusy.val=0
  pInit.vRetry.val=0
  if(pInit.nAckCode.val==4||pInit.nAckCode.val==8)
  {
  pInit.nBoot.val=0
  pInit.vStep.val=0
  pInit.vTap.val=0
  pInit.vStatusReady.val=0
  }else
  {
  if(pInit.vTask.val==0)
  {
  if(pInit.vGet.val==1)
  {
  if(pInit.nAckCode.val==0)
  {
  pInit.tStatus.txt=pInit.tData.txt
  spstr pInit.tData.txt,pInit.tTime.txt,"|",1
  tClock.txt="--:--"
  if(pInit.tTime.txt!="")
  {
  substr pInit.tTime.txt,tClock.txt,0,5
  }
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",3
  tBatt.txt="--%"
  tBatt.pco=65535
  pInit.vTemp.val=0
  if(pInit.tSplit.txt!="")
  {
  covx pInit.tSplit.txt,pInit.vTemp.val,0,0
  tBatt.txt=pInit.tSplit.txt
  tBatt.txt+="%"
  if(pInit.vTemp.val<=40)
  {
  tBatt.pco=65132
  }
  if(pInit.vTemp.val<=20)
  {
  tBatt.pco=64329
  }
  pInit.vTemp.val*=11
  pInit.vTemp.val+=50
  pInit.vTemp.val/=100
  }
  picq 367,82,22,22,23
  if(pInit.vTemp.val>0)
  {
  fill 371,90,pInit.vTemp.val,6,tBatt.pco
  }
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",4
  covx pInit.tSplit.txt,pInit.vStorage.val,0,0
  spstr pInit.tData.txt,pInit.tDate.txt,"|",0
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",14
  covx pInit.tSplit.txt,pInit.vMask.val,0,0
  pInit.vSensors.val=0
  pInit.vCount.val=pInit.vMask.val
  if(pInit.vCount.val>=4)
  {
  pInit.vSensors.val+=1
  pInit.vCount.val-=4
  }
  if(pInit.vCount.val>=2)
  {
  pInit.vSensors.val+=1
  pInit.vCount.val-=2
  }
  if(pInit.vCount.val>=1)
  {
  pInit.vSensors.val+=1
  }
  pInit.vStatusReady.val=1
  }
  }
  if(pInit.vGet.val==2)
  {
  if(pInit.nAckCode.val==0)
  {
  spstr pInit.tData.txt,tBase.txt,"|",1
  spstr pInit.tData.txt,tTarget.txt,"|",2
  if(tTarget.txt!="")
  {
  tTarget.txt+=" MPa"
  }
  spstr pInit.tData.txt,tDatum.txt,"|",3
  if(tDatum.txt!="")
  {
  tDatum.txt+=" °C"
  }
  }
  }
  if(pInit.vGet.val==3)
  {
  if(pInit.nAckCode.val==0)
  {
  spstr pInit.tData.txt,tPDate.txt,"|",4
  strlen tPDate.txt,pInit.vTemp.val
  if(pInit.vTemp.val==10)
  {
  spstr tPDate.txt,pInit.tNum.txt,"-",2
  spstr tPDate.txt,pInit.tSplit.txt,"-",1
  pInit.tNum.txt+="-"
  pInit.tNum.txt+=pInit.tSplit.txt
  spstr tPDate.txt,pInit.tSplit.txt,"-",0
  pInit.tNum.txt+="-"
  pInit.tNum.txt+=pInit.tSplit.txt
  tPDate.txt=pInit.tNum.txt
  }
  spstr pInit.tData.txt,tPour.txt,"|",5
  spstr pInit.tData.txt,tInitTemp.txt,"|",8
  spstr pInit.tData.txt,tElapsed.txt,"|",9
  pInit.vRevision.val=pInit.nAckValue.val
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",2
  covx pInit.tSplit.txt,pInit.vTotal.val,0,0
  }
  }
  if(pInit.vGet.val==4)
  {
  if(pInit.nAckCode.val==0)
  {
  spstr pInit.tData.txt,tId.txt,"|",0
  spstr pInit.tData.txt,tSavedAt.txt,"|",1
  strlen tSavedAt.txt,pInit.vTemp.val
  if(pInit.vTemp.val==10)
  {
  spstr tSavedAt.txt,pInit.tNum.txt,"-",2
  spstr tSavedAt.txt,pInit.tSplit.txt,"-",1
  pInit.tNum.txt+="-"
  pInit.tNum.txt+=pInit.tSplit.txt
  spstr tSavedAt.txt,pInit.tSplit.txt,"-",0
  pInit.tNum.txt+="-"
  pInit.tNum.txt+=pInit.tSplit.txt
  tSavedAt.txt=pInit.tNum.txt
  }
  spstr pInit.tData.txt,tOp.txt,"|",3
  spstr pInit.tData.txt,tProj.txt,"|",4
  spstr pInit.tData.txt,tDate.txt,"|",2
  }
  }
  if(pInit.vGet.val==5)
  {
  if(pInit.nAckCode.val!=0)
  {
  pInit.tData.txt=""
  }
  if(tRowData0.txt!=pInit.tData.txt)
  {
  tRowData0.txt=pInit.tData.txt
  pInit.vListDirty.val=1
  }
  }
  if(pInit.vGet.val==6)
  {
  if(pInit.nAckCode.val!=0)
  {
  pInit.tData.txt=""
  }
  if(tRowData1.txt!=pInit.tData.txt)
  {
  tRowData1.txt=pInit.tData.txt
  pInit.vListDirty.val=1
  }
  }
  if(pInit.vGet.val==7)
  {
  if(pInit.nAckCode.val!=0)
  {
  pInit.tData.txt=""
  }
  if(tRowData2.txt!=pInit.tData.txt)
  {
  tRowData2.txt=pInit.tData.txt
  pInit.vListDirty.val=1
  }
  }
  if(pInit.vGet.val==8)
  {
  if(pInit.nAckCode.val!=0)
  {
  pInit.tData.txt=""
  }
  if(tRowData3.txt!=pInit.tData.txt)
  {
  tRowData3.txt=pInit.tData.txt
  pInit.vListDirty.val=1
  }
  }
  if(pInit.vGet.val==9)
  {
  if(pInit.nAckCode.val!=0)
  {
  pInit.tData.txt=""
  }
  if(tRowData4.txt!=pInit.tData.txt)
  {
  tRowData4.txt=pInit.tData.txt
  pInit.vListDirty.val=1
  }
  }
  pInit.vStep.val+=1
  }else
  {
  if(pInit.nAckCode.val==13)
  {
  pInit.vToken.val=pInit.nAckValue.val
  page pConfirm
  }else
  {
  if(pInit.nAckCode.val!=0)
  {
  pInit.tMsg.txt="ConMT error "
  covx pInit.nAckCode.val,pInit.tNum.txt,0,0
  pInit.tMsg.txt+=pInit.tNum.txt
  if(pInit.nAckCode.val==1)
  {
  pInit.tMsg.txt="Invalid input. Check the field format."
  }
  if(pInit.nAckCode.val==2)
  {
  pInit.tMsg.txt="Complete the required fields"
  }
  if(pInit.nAckCode.val==3)
  {
  pInit.tMsg.txt="Complete the previous step first"
  if(pInit.vPage.val==8||pInit.vPage.val==10)
  {
  pInit.tMsg.txt="Select a baseline first"
  }
  }
  if(pInit.nAckCode.val==15)
  {
  pInit.tMsg.txt="This item is no longer available"
  }
  if(pInit.nAckCode.val==6)
  {
  pInit.tMsg.txt="Check the microSD card"
  }
  if(pInit.nAckCode.val==9)
  {
  pInit.tMsg.txt="Connect a temperature probe"
  }
  if(pInit.nAckCode.val==10)
  {
  pInit.tMsg.txt="Set date/time before measurement"
  }
  if(pInit.nAckCode.val==11)
  {
  pInit.tMsg.txt="Enter at least two valid lab pairs"
  }
  if(pInit.nAckCode.val==12)
  {
  pInit.tMsg.txt="Add a later checkpoint before SAVE"
  }
  }else
  {
  pInit.tMsg.txt=""

  }
  pInit.vListDirty.val=1
  pInit.vStep.val=1
  }
  }
  }
  }
  else
  {
  pInit.vRetry.val+=1
  if(pInit.vRetry.val==58)
  {
  prints pInit.tReq.txt,0
  printh 0A
  }
  if(pInit.vRetry.val>=116)
  {
  pInit.vBusy.val=0
  pInit.nBoot.val=0
  pInit.vStep.val=0
  pInit.vTap.val=0
  pInit.vStatusReady.val=0
  pInit.tMsg.txt="No answer from MCU"
  tClock.txt="--:--"
  tBatt.txt="--%"
  tBatt.pco=65535
  pInit.vTemp.val=0
  picq 367,82,22,22,23
  if(pInit.vTemp.val>0)
  {
  fill 371,90,pInit.vTemp.val,6,tBatt.pco
  }
  }
  }
  }
  if(tNotice.txt!=pInit.tMsg.txt)
  {
  tNotice.txt=pInit.tMsg.txt
  }
  if(pInit.vBusy.val==0&&dp==14)
  {
  if(pInit.vTouchPhase.val==0&&pInit.vListReady.val==1&&pInit.vListShift.val!=0)
  {
  pInit.vListMax.val=pInit.vTotal.val-5
  if(pInit.vListMax.val<0)
  {
  pInit.vListMax.val=0
  }
  pInit.vIndex.val=pInit.vListBase.val+pInit.vListShift.val
  if(pInit.vIndex.val<0)
  {
  pInit.vIndex.val=0
  }
  if(pInit.vIndex.val>pInit.vListMax.val)
  {
  pInit.vIndex.val=pInit.vListMax.val
  }
  if(pInit.vIndex.val!=pInit.vListBase.val)
  {
  pInit.vListShift.val=pInit.vIndex.val-pInit.vListBase.val
  pInit.vListBase.val=pInit.vIndex.val
  pInit.vListReady.val=0
  pInit.vListDirty.val=1
  pInit.vListReuse.val=1
  pInit.vStep.val=5
  if(pInit.vListShift.val>=5||pInit.vListShift.val<=-5)
  {
  pInit.vListReuse.val=0
  }else
  {
  while(pInit.vListShift.val>0)
  {
  tRowData0.txt=tRowData1.txt
  tRowData1.txt=tRowData2.txt
  tRowData2.txt=tRowData3.txt
  tRowData3.txt=tRowData4.txt
  tRowData4.txt=""
  pInit.vListShift.val-=1
  }
  while(pInit.vListShift.val<0)
  {
  tRowData4.txt=tRowData3.txt
  tRowData3.txt=tRowData2.txt
  tRowData2.txt=tRowData1.txt
  tRowData1.txt=tRowData0.txt
  tRowData0.txt=""
  pInit.vListShift.val+=1
  }
  }
  }
  pInit.vListShift.val=0
  }
  }
  if(dp==14&&pInit.vBusy.val==0&&pInit.vTap.val>0&&pInit.vStatusReady.val==1)
  {
  pInit.vDispatch.val=pInit.vTap.val
  pInit.vTap.val=0
  if(pInit.vTapView.val==pInit.nView.val&&pInit.vTapBoot.val==pInit.nBoot.val)
  {
  if(pInit.vDispatch.val==1)
  {
  click mBack,0
  }
  }
  else
  {
  pInit.tMsg.txt="View updated. Tap again."
  }
  }
  if(pInit.vBusy.val==0&&dp==14)
  {
  if(pInit.vStep.val==0)
  {
  pInit.vGet.val=0
  if(pInit.vBusy.val==0)
  {
  pInit.vSeq.val+=1
  pInit.nAckSeq.val=0
  pInit.vBusy.val=1
  pInit.vRetry.val=0
  pInit.vTask.val=0
  pInit.tReq.txt="CM1|"
  covx pInit.nBoot.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vSeq.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vPage.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.nView.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  pInit.tReq.txt+="PAGE_READY"
  prints pInit.tReq.txt,0
  printh 0A
  }
  }
  if(pInit.vStep.val==1)
  {
  pInit.vGet.val=1
  pInit.tCommand.txt="GET|status"
  if(pInit.vBusy.val==0)
  {
  pInit.vSeq.val+=1
  pInit.nAckSeq.val=0
  pInit.vBusy.val=1
  pInit.vRetry.val=0
  pInit.vTask.val=0
  pInit.tReq.txt="CM1|"
  covx pInit.nBoot.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vSeq.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vPage.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.nView.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  pInit.tReq.txt+=pInit.tCommand.txt
  prints pInit.tReq.txt,0
  printh 0A
  }
  }
  if(pInit.vStep.val==2)
  {
  pInit.vGet.val=2
  pInit.tCommand.txt="GET|baseline"
  if(pInit.vBusy.val==0)
  {
  pInit.vSeq.val+=1
  pInit.nAckSeq.val=0
  pInit.vBusy.val=1
  pInit.vRetry.val=0
  pInit.vTask.val=0
  pInit.tReq.txt="CM1|"
  covx pInit.nBoot.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vSeq.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vPage.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.nView.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  pInit.tReq.txt+=pInit.tCommand.txt
  prints pInit.tReq.txt,0
  printh 0A
  }
  }
  if(pInit.vStep.val==3)
  {
  pInit.vGet.val=3
  pInit.tCommand.txt="GET|run"
  if(pInit.vBusy.val==0)
  {
  pInit.vSeq.val+=1
  pInit.nAckSeq.val=0
  pInit.vBusy.val=1
  pInit.vRetry.val=0
  pInit.vTask.val=0
  pInit.tReq.txt="CM1|"
  covx pInit.nBoot.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vSeq.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vPage.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.nView.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  pInit.tReq.txt+=pInit.tCommand.txt
  prints pInit.tReq.txt,0
  printh 0A
  }
  }
  if(pInit.vStep.val==4)
  {
  pInit.vGet.val=4
  pInit.tCommand.txt="GET|detail"
  if(pInit.vBusy.val==0)
