    {
      "type": "TouchCap",
      "objname": "mAddDay",
      "x": 40,
      "y": 488,
      "w": 200,
      "h": 40,
      "label": "+ ADD DAY",
      "events": {
        "touchpress": "prints \"ADD\\r\\n\",0"
      },
      "note": "MCU menambah checkpoint hari berikutnya (auto temp dari baseline/sensor)."
    },
    {
      "type": "TouchCap",
      "objname": "mDemo",
      "x": 250,
      "y": 488,
      "w": 190,
      "h": 40,
      "label": "LOAD EXCEL DEMO",
      "events": {
        "touchpress": "prints \"DEMO\\r\\n\",0"
      },
      "note": "Opsional: MCU isi semua day dari baris baseline/Excel."
    },
    {
      "type": "TouchCap",
      "objname": "mBack",
      "x": 84,
      "y": 700,
      "w": 150,
      "h": 44,
      "label": "BACK",
      "events": {
        "touchpress": "page pSelB"
      }
    },
    {
      "type": "TouchCap",
      "objname": "mNext",
      "x": 245,
      "y": 700,
      "w": 150,
      "h": 44,
      "label": "NEXT",
      "events": {
        "touchpress": "prints \"NEXT\\r\\n\",0\r\npage pStr"
      },
      "note": "Kirim NEXT ke MCU (lock endMs ke last log) lalu buka pStr."
    }
  ],
  "events": {
    "mAddDay.touchpress": "events/pRT_mAddDay.txt",
    "mDemo.touchpress": "events/pRT_mDemo.txt",
    "mBack.touchpress": "events/pRT_mBack.txt",
    "mNext.touchpress": "events/pRT_mNext.txt"
  },
  "serialProtocol": {
    "fromHmi": [
      "ADD   — log next day checkpoint",
      "DEMO  — fill demo days from baseline rows",
      "NEXT  — finalize measurement (endMs = last log)"
    ],
    "fromMcu": [
      "tS1/tS2/tS3/tAvg.txt — live sensors",
      "tM.txt / tFcLive.txt / tPctLive.txt — live prediction",
      "tPourDate/tPour/tInitTemp — locked at START",
      "tCurDate/tCurTime/tCurTemp — live clock/temp",
      "tL0..tL3.txt — logged day lines",
      "tLogCount.txt / tHint.txt",
      "Each command ends with 0xFF 0xFF 0xFF"
    ]
  },
  "note": "Elapsed dihapus dari UI. Result lock ke last logged checkpoint, bukan waktu tombol NEXT."
}
