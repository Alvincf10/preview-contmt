on pMatu.loadend:
  if(pInit.vPage.val!=6)
  {
  pInit.vOffset.val=0
  pInit.vFocusId.val=0
  pInit.vFocusFirst.val=0
  pInit.vFocusRow.val=0
  }
  pInit.vPage.val=6
  pInit.vBusy.val=0
  pInit.vRetry.val=0
  pInit.vStep.val=0
  pInit.vPoll.val=0
  pInit.vTap.val=0
  pInit.vStatusReady.val=0
  pInit.vTask.val=0
  pInit.tMsg.txt=""
  tClock.txt="--:--"
  tBatt.txt="--%"
  tBatt.pco=65535
  pInit.vTemp.val=0
  picq 367,82,22,22,9
  if(pInit.vTemp.val>0)
  {
  fill 371,90,pInit.vTemp.val,6,tBatt.pco
  }
  pInit.vLab0.val=0
  tsw tDay0,0
  vis tDay0,0
  tsw tTim0,0
  vis tTim0,0
  tsw tFc0,0
  vis tFc0,0
  tsw tT0,0
  vis tT0,0
  tsw mDelete0,0
  vis mDelete0,0
  picq 68,245,344,57,9
  pInit.vLab1.val=0
  tsw tDay1,0
  vis tDay1,0
  tsw tTim1,0
  vis tTim1,0
  tsw tFc1,0
  vis tFc1,0
  tsw tT1,0
  vis tT1,0
  tsw mDelete1,0
  vis mDelete1,0
  picq 68,302,344,57,9
  pInit.vLab2.val=0
  tsw tDay2,0
  vis tDay2,0
  tsw tTim2,0
  vis tTim2,0
  tsw tFc2,0
  vis tFc2,0
  tsw tT2,0
  vis tT2,0
  tsw mDelete2,0
  vis mDelete2,0
  picq 68,359,344,57,9
  pInit.vLab3.val=0
  tsw tDay3,0
  vis tDay3,0
  tsw tTim3,0
  vis tTim3,0
  tsw tFc3,0
  vis tFc3,0
  tsw tT3,0
  vis tT3,0
  tsw mDelete3,0
  vis mDelete3,0
  picq 68,416,344,57,9
  pInit.vLab4.val=0
  tsw tDay4,0
  vis tDay4,0
  tsw tTim4,0
  vis tTim4,0
  tsw tFc4,0
  vis tFc4,0
  tsw tT4,0
  vis tT4,0
  tsw mDelete4,0
  vis mDelete4,0
  picq 68,473,344,56,9
  pInit.vDraft.val=0
  pInit.vLabSlots.val=-1
  tPageRows.txt=""
  tsw mAddDay,0
  vis mAddDay,0
  tsw mSensor,0
  vis mSensor,0
  tmDrag.en=0
  vBlockTap.val=0
  pInit.vTouchPhase.val=0
  pInit.vListBase.val=pInit.vOffset.val
  pInit.vListShift.val=0
  pInit.vListReuse.val=0
  pInit.vListDirty.val=1
  pInit.vListReady.val=0

on tcList.down:
  if(pInit.vTouchPhase.val==2)
  {
  pInit.vTap.val=0
  }
  tmDrag.en=0
  pInit.vTouchPhase.val=0
  vBlockTap.val=0
  vStartX.val=tch0
  vStartY.val=tch1
  if(vStartX.val>=68&&vStartX.val<420&&vStartY.val>=245&&vStartY.val<529)
  {
  pInit.vTouchPhase.val=1
  vPriorX.val=tch2
  vPriorY.val=tch3
  vDragX.val=0
  vDragY.val=0
  tmDrag.en=1
  if(pInit.vListReady.val==0||pInit.vListShift.val!=0)
  {
  vBlockTap.val=1
  }
  }

on tcList.up:
  if(pInit.vTouchPhase.val==1)
  {
  pInit.vTouchPhase.val=2
  }

on tmDrag.timer:
  if(pInit.vTouchPhase.val==1)
  {
  if(tch0!=0||tch1!=0)
  {
  vDragX.val=tch0-vStartX.val
  if(vDragX.val<0)
  {
  vDragX.val*=-1
  }
  vDragY.val=vStartY.val-tch1
  if(vDragX.val>=16||vDragY.val>=16||vDragY.val<=-16)
  {
  vBlockTap.val=1
  }
  }
  }
  else
  {
  tmDrag.en=0
  pInit.vTouchPhase.val=0
  if(tch0==0&&tch1==0)
  {
  if(tch2!=vPriorX.val||tch3!=vPriorY.val)
  {
  if(tch2>=0&&tch2<480&&tch3>=0&&tch3<800)
  {
  vDragX.val=tch2-vStartX.val
  if(vDragX.val<0)
  {
  vDragX.val*=-1
  }
  vDragY.val=vStartY.val-tch3
  if(vDragX.val>=16||vDragY.val>=16||vDragY.val<=-16)
  {
  vBlockTap.val=1
  }
  }
  }
  pInit.vTemp.val=vDragY.val
  if(pInit.vTemp.val<0)
  {
  pInit.vTemp.val*=-1
  }
  if(pInit.vTemp.val>=22&&pInit.vTemp.val>vDragX.val)
  {
  pInit.vTemp.val+=28
  pInit.vTemp.val/=57
  if(pInit.vTemp.val<1)
  {
  pInit.vTemp.val=1
  }
  if(vDragY.val>0)
  {
  pInit.vListShift.val+=pInit.vTemp.val
  }else
  {
  pInit.vListShift.val-=pInit.vTemp.val
  }
  vBlockTap.val=1
  }
  }
  else
  {
  vBlockTap.val=1
  }
  if(vBlockTap.val==1)
  {
  pInit.vTap.val=0
  }
  }

on tmPoll.timer:
  if(pInit.vBusy.val==1)
  {
  if(pInit.nAckSeq.val==pInit.vSeq.val)
  {
  pInit.vBusy.val=0
  pInit.vRetry.val=0
  if(pInit.nAckCode.val==4||pInit.nAckCode.val==8)
  {
  pInit.nBoot.val=0
  pInit.vStep.val=0
  pInit.vTap.val=0
  pInit.vStatusReady.val=0
  }else
  {
  if(pInit.vTask.val==0)
  {
  if(pInit.vGet.val==1)
  {
  if(pInit.nAckCode.val==0)
  {
  pInit.tStatus.txt=pInit.tData.txt
  spstr pInit.tData.txt,pInit.tTime.txt,"|",1
  tClock.txt="--:--"
  if(pInit.tTime.txt!="")
  {
  substr pInit.tTime.txt,tClock.txt,0,5
  }
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",3
  tBatt.txt="--%"
  tBatt.pco=65535
  pInit.vTemp.val=0
  if(pInit.tSplit.txt!="")
  {
  covx pInit.tSplit.txt,pInit.vTemp.val,0,0
  tBatt.txt=pInit.tSplit.txt
  tBatt.txt+="%"
  if(pInit.vTemp.val<=40)
  {
  tBatt.pco=65132
  }
  if(pInit.vTemp.val<=20)
  {
  tBatt.pco=64329
  }
  pInit.vTemp.val*=11
  pInit.vTemp.val+=50
  pInit.vTemp.val/=100
  }
  picq 367,82,22,22,9
  if(pInit.vTemp.val>0)
  {
  fill 371,90,pInit.vTemp.val,6,tBatt.pco
  }
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",4
  covx pInit.tSplit.txt,pInit.vStorage.val,0,0
