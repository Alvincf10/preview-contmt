  spstr pInit.tData.txt,tTim7.txt,"|",3
  spstr pInit.tData.txt,tFc7.txt,"|",5
  spstr pInit.tData.txt,tT7.txt,"|",4
  pInit.vTotal.val=pInit.nAckValue.val
  }
  else
  {
  tDay7.txt=""
  tTim7.txt=""
  tFc7.txt=""
  tT7.txt=""
  }
  }
  if(pInit.vGet.val==11)
  {
  if(pInit.nAckCode.val==0)
  {
  spstr pInit.tData.txt,tDay8.txt,"|",1
  spstr pInit.tData.txt,tTim8.txt,"|",3
  spstr pInit.tData.txt,tFc8.txt,"|",5
  spstr pInit.tData.txt,tT8.txt,"|",4
