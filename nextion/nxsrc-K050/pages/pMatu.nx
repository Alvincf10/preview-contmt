on tPourTime.up:
  if(pInit.vBusy.val==0&&pInit.vStatusReady.val==1)
  {
  if(pInit.vBusy.val==0)
  {
  pInit.tField.txt="pourClock"
  pInit.tTitle.txt="Time HH:MM:SS"
  pInit.tEdit.txt=tPourTime.txt
  pInit.vEditKind.val=0
  pInit.vEditPage.val=pInit.vPage.val
  pInit.vMax.val=8
  pInit.vInputMode.val=4
  pInit.vEditView.val=pInit.nView.val
  pInit.vEditBoot.val=pInit.nBoot.val
  page pNumber
