on pChart.loadend:
  pInit.vBusy.val=0
  vPlotAction.val=0
  vPlotPhase.val=1
  vPoint.val=0
  vMaxX.val=0
  picq 26,194,428,430,32
  line 62,586,428,586,16970
  xstr 39,577,21,18,0,65535,4292,2,1,3,"0"
  line 62,511,428,511,16970
  xstr 39,502,21,18,0,65535,4292,2,1,3,"10"
  line 62,435,428,435,16970
  xstr 39,426,21,18,0,65535,4292,2,1,3,"20"
  line 62,360,428,360,16970
  xstr 39,351,21,18,0,65535,4292,2,1,3,"30"
  line 62,284,428,284,16970
  xstr 39,275,21,18,0,65535,4292,2,1,3,"40"
  line 62,208,428,208,16970
  xstr 39,199,21,18,0,65535,4292,2,1,3,"50"
  tFit.txt=pInit.tPlotFit.txt

on mBack.up:
  vPlotAction.val=1

on tmChart.timer:
  if(pInit.vBusy.val==1)
  {
  if(pInit.nAckSeq.val==pInit.vSeq.val)
  {
  pInit.vBusy.val=0
  if(pInit.nAckCode.val==0)
  {
  if(vMaxX.val==0)
  {
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",2
  covx pInit.tSplit.txt,vMaxX.val,0,0
  if(vMaxX.val>0)
  {
  vTickStep.val=vMaxX.val/40000
  vTickStep.val+=1
  vTickStep.val*=5000
  vTick.val=0
  while(vTick.val<=vMaxX.val)
  {
  vX.val=vTick.val
  vDiv.val=vMaxX.val
  if(vMaxX.val>5000000)
  {
  vDiv.val/=1000
  vX.val/=1000
  }
  vX.val*=366
  vX.val/=vDiv.val
  vX.val+=62
  line vX.val,208,vX.val,586,16970
  vX.val-=20
  pInit.vTemp.val=vTick.val/1000
  covx pInit.vTemp.val,pInit.tNum.txt,0,0
  if(vTick.val>0)
  {
  pInit.tNum.txt+="k"
  }
  xstr vX.val,590,40,18,0,65535,0,1,1,3,pInit.tNum.txt
  vTick.val+=vTickStep.val
  }
  draw 62,208,428,586,33907
  }
  }
  if(vMaxX.val>0)
  {
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",0
  if(pInit.tSplit.txt!="")
  {
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",1
  if(pInit.tSplit.txt!="")
  {
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",0
  spstr pInit.tSplit.txt,tWhole.txt,".",0
  covx tWhole.txt,vX.val,0,0
  vDiv.val=vMaxX.val
  if(vMaxX.val>5000000)
  {
  vDiv.val/=1000
  vX.val/=1000
  }
  vX.val*=366
  vX.val/=vDiv.val
  vX.val+=62
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",1
  spstr pInit.tSplit.txt,tWhole.txt,".",0
  covx tWhole.txt,vY.val,0,0
  if(vY.val>22000)
  {
  vY.val=22000
  }
  if(vY.val<-22000)
  {
  vY.val=-22000
  }
  vY.val*=100
  spstr pInit.tSplit.txt,tWhole.txt,".",1
  substr tWhole.txt,pInit.tNum.txt,0,2
  covx pInit.tNum.txt,pInit.vTemp.val,0,0
  substr pInit.tSplit.txt,tWhole.txt,0,1
  if(tWhole.txt=="-")
  {
  vY.val-=pInit.vTemp.val
  }else
  {
  vY.val+=pInit.vTemp.val
  }
  vY.val*=378
  vY.val/=5000
  vY.val=586-vY.val
  if(vPlotPhase.val==1)
  {
  if(vPoint.val>0)
  {
  vX0.val=vLastX.val
  vY0.val=vLastY.val
  vX1.val=vX.val
  vY1.val=vY.val
  if(vY0.val<208&&vY1.val>=208)
  {
  vDelta.val=vX1.val-vX0.val
  pInit.vTemp.val=208-vY0.val
  vDelta.val*=pInit.vTemp.val
  pInit.vTemp.val=vY1.val-vY0.val
  vDelta.val/=pInit.vTemp.val
  vX0.val+=vDelta.val
  vY0.val=208
  }
  if(vY1.val<208&&vY0.val>=208)
  {
  vDelta.val=vX0.val-vX1.val
  pInit.vTemp.val=208-vY1.val
  vDelta.val*=pInit.vTemp.val
  pInit.vTemp.val=vY0.val-vY1.val
  vDelta.val/=pInit.vTemp.val
  vX1.val+=vDelta.val
  vY1.val=208
  }
  if(vY0.val>586&&vY1.val<=586)
  {
  vDelta.val=vX1.val-vX0.val
  pInit.vTemp.val=586-vY0.val
  vDelta.val*=pInit.vTemp.val
  pInit.vTemp.val=vY1.val-vY0.val
  vDelta.val/=pInit.vTemp.val
  vX0.val+=vDelta.val
  vY0.val=586
  }
  if(vY1.val>586&&vY0.val<=586)
  {
  vDelta.val=vX0.val-vX1.val
  pInit.vTemp.val=586-vY1.val
  vDelta.val*=pInit.vTemp.val
  pInit.vTemp.val=vY0.val-vY1.val
  vDelta.val/=pInit.vTemp.val
  vX1.val+=vDelta.val
  vY1.val=586
  }
  if(vY0.val>=208&&vY0.val<=586&&vY1.val>=208&&vY1.val<=586)
  {
  line vX0.val,vY0.val,vX1.val,vY1.val,64710
  }
  }
  vLastX.val=vX.val
  vLastY.val=vY.val
  }else
  {
  if(vX.val>=62&&vX.val<=428&&vY.val>=208&&vY.val<=586)
  {
  cirs vX.val,vY.val,3,64710
  cir vX.val,vY.val,3,65535
  }
  }
  }
  }
  }
  vPoint.val+=1
  if(vPlotPhase.val==1&&vPoint.val==65)
  {
  vPlotPhase.val=2
  vPoint.val=0
  }
  if(vPlotPhase.val==2&&vPoint.val>=pInit.vPairs.val)
  {
  vPlotPhase.val=3
  }
  }
  else
  {
  vPlotPhase.val=3
  tError.txt="Chart data unavailable"
  }
  }
  else
  {
  pInit.vRetry.val+=1
  if(pInit.vRetry.val==15)
  {
  prints pInit.tReq.txt,0
  printh 0A
  }
  if(pInit.vRetry.val>=30)
  {
  pInit.vBusy.val=0
  tError.txt="No answer. Return and reconnect."
  }
  if(pInit.vBusy.val==0)
  {
  vPlotPhase.val=3
  }
  }
  }
  if(pInit.vBusy.val==0&&vPlotAction.val==1)
  {
  page pInit.vPage.val
  }
  if(dp==21&&pInit.vBusy.val==0&&vPlotPhase.val<3)
  {
  pInit.tCommand.txt="GET|curve|"
  if(vPlotPhase.val==2)
  {
  pInit.tCommand.txt="GET|scatter|"
  }
  covx vPoint.val,pInit.tNum.txt,0,0
  pInit.tCommand.txt+=pInit.tNum.txt
  if(pInit.vBusy.val==0)
  {
  pInit.vSeq.val+=1
  pInit.nAckSeq.val=0
  pInit.vBusy.val=1
  pInit.vRetry.val=0
  pInit.vTask.val=0
  pInit.tReq.txt="CM1|"
  covx pInit.nBoot.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vSeq.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vPage.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.nView.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  pInit.tReq.txt+=pInit.tCommand.txt
  prints pInit.tReq.txt,0
  printh 0A
  }
  }
