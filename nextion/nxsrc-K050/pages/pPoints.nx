  {
  pInit.tField.txt="day"
  pInit.tTitle.txt="day"
  pInit.tEdit.txt=tDay0.txt
  pInit.vEditKind.val=3
  pInit.vEditPage.val=20
  pInit.vMax.val=24
  pInit.vInputMode.val=1
  pInit.vEditView.val=pInit.nView.val
  pInit.vEditBoot.val=pInit.nBoot.val
  pInit.vEditRow.val=pInit.vOffset.val+0
  page pNumber
  }
  }
  else
  {
