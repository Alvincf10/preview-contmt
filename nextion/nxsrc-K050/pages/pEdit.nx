on pEdit.loadend:
  tTitle.txt=pInit.tTitle.txt
  tInput.txt=pInit.tEdit.txt
  tError.txt=""
  vCase.val=0
  vis kProbe,0
  if(pInit.vEditKind.val==1&&pInit.tField.txt=="temp")
  {
  vis kProbe,1
  }

on k00.up:
  if(pInit.vBusy.val==0)
  {
  strlen tInput.txt,pInit.vTemp.val
  if(pInit.vTemp.val<pInit.vMax.val)
  {
  tInput.txt+=k00.txt
  }
  }

