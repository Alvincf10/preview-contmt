on pInit.loadend:
  if(pInit.vPage.val!=0)
  {
  pInit.vOffset.val=0
  }
  pInit.vPage.val=0
  pInit.vBusy.val=0
  pInit.vRetry.val=0
  pInit.vStep.val=0
  pInit.vPoll.val=0
  pInit.tMsg.txt=""
  pInit.nBoot.val=0
  pInit.vProtocolReady.val=0
  pInit.vSplashStage.val=0
  tmSplash.en=0
  tmSplash.tim=650
  jLink.val=0
  tProgress.txt="0%"

on tmSplash.timer:
  if(pInit.vProtocolReady.val==1)
  {
  if(pInit.vSplashStage.val<4)
  {
  pInit.vSplashStage.val+=1
  pInit.vTemp.val=pInit.vSplashStage.val*25
  jLink.val=pInit.vTemp.val
  covx pInit.vTemp.val,tProgress.txt,0,0
  tProgress.txt+="%"
  if(pInit.vSplashStage.val==1)
  {
  tReady.txt="Application started"
  }
  if(pInit.vSplashStage.val==4)
  {
  tChkDevice.txt="Device responded"
  tmSplash.tim=700
  }
  }
  else
  {
  if(pInit.vBusy.val==0)
  {
  pInit.vSeq.val+=1
  pInit.nAckSeq.val=0
  pInit.vBusy.val=1
  pInit.vRetry.val=0
  pInit.vTask.val=1
  pInit.tReq.txt="CM1|"
  covx pInit.nBoot.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vSeq.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vPage.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.nView.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  pInit.tReq.txt+="NAV|1"
  prints pInit.tReq.txt,0
  printh 0A
  }
  }
  }

on tmPoll.timer:
  if(pInit.vBusy.val==1)
  {
  if(pInit.nAckSeq.val==pInit.vSeq.val)
  {
  pInit.vBusy.val=0
  pInit.vRetry.val=0
  if(pInit.nAckCode.val==4||pInit.nAckCode.val==8)
  {
  pInit.nBoot.val=0
  pInit.vStep.val=0
  }else
  {
  if(pInit.vTask.val==0)
  {
  if(pInit.vGet.val==1)
  {
  if(pInit.nAckCode.val==0)
  {
  pInit.tStatus.txt=pInit.tData.txt
  spstr pInit.tData.txt,tClock.txt,"|",1
  spstr pInit.tData.txt,tBatt.txt,"|",3
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",4
  covx pInit.tSplit.txt,pInit.vStorage.val,0,0
  spstr pInit.tData.txt,pInit.tDate.txt,"|",0
  spstr pInit.tData.txt,pInit.tTime.txt,"|",1
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",14
  covx pInit.tSplit.txt,pInit.vMask.val,0,0
  pInit.vSensors.val=0
  pInit.vCount.val=pInit.vMask.val
  if(pInit.vCount.val>=4)
  {
  pInit.vSensors.val+=1
  pInit.vCount.val-=4
  }
  if(pInit.vCount.val>=2)
  {
  pInit.vSensors.val+=1
  pInit.vCount.val-=2
  }
  if(pInit.vCount.val>=1)
  {
  pInit.vSensors.val+=1
  }
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",9
  pInit.vProtocolReady.val=0
  if(pInit.tSplit.txt=="1.0.1")
  {
  pInit.vProtocolReady.val=1
  }
  if(pInit.vProtocolReady.val==1&&pInit.vSplashStage.val==0&&tmSplash.en==0)
  {
  tmSplash.en=1
  }
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",17
  covx pInit.tSplit.txt,pInit.vIdentity.val,0,0
  tChkClock.txt="Database: OK"
  if(pInit.vStorage.val!=0)
  {
  tChkClock.txt="Database error "
  covx pInit.vStorage.val,pInit.tNum.txt,0,0
  tChkClock.txt+=pInit.tNum.txt
  }
  tChkSensors.txt="Sensors: "
  covx pInit.vSensors.val,pInit.tNum.txt,0,0
  tChkSensors.txt+=pInit.tNum.txt
  tChkSensors.txt+="/3"
  if(pInit.vSensors.val==0)
  {
  tChkSensors.txt="No sensor detected"
  }
  if(pInit.vProtocolReady.val==0)
  {
  tReady.txt="Update MCU firmware to 1.0.1"
  tProgress.txt="0%"
  jLink.val=0
  tmSplash.en=0
  pInit.vSplashStage.val=0
  }
  }
  }
  pInit.vStep.val+=1
  }else
  {
  if(pInit.nAckCode.val==13)
  {
  pInit.vToken.val=pInit.nAckValue.val
  page pConfirm
  }else
  {
  if(pInit.nAckCode.val!=0)
  {
  pInit.tMsg.txt="ConMT error "
  covx pInit.nAckCode.val,pInit.tNum.txt,0,0
  pInit.tMsg.txt+=pInit.tNum.txt
  if(pInit.nAckCode.val==1)
  {
  pInit.tMsg.txt="Invalid input. Check the field format."
  }
  if(pInit.nAckCode.val==2)
  {
  pInit.tMsg.txt="Complete the required fields"
  }
  if(pInit.nAckCode.val==6)
  {
  pInit.tMsg.txt="Check the microSD card"
  }
  if(pInit.nAckCode.val==9)
  {
  pInit.tMsg.txt="Connect a temperature probe"
  }
  if(pInit.nAckCode.val==10)
  {
  pInit.tMsg.txt="Set date/time before measurement"
  }
  if(pInit.nAckCode.val==11)
  {
  pInit.tMsg.txt="Enter at least two valid lab pairs"
  }
  if(pInit.nAckCode.val==12)
  {
  pInit.tMsg.txt="Add a later checkpoint before SAVE"
  }
  }else
  {
  pInit.tMsg.txt=""
  }
  pInit.vStep.val=1
  }
  }
  }
  }
  else
  {
  pInit.vRetry.val+=1
  if(pInit.vRetry.val==15)
  {
  prints pInit.tReq.txt,0
  printh 0A
  }
  if(pInit.vRetry.val>=30)
  {
  pInit.vBusy.val=0
  pInit.nBoot.val=0
  pInit.vStep.val=0
  pInit.tMsg.txt="No answer from MCU"
  }
  }
  }
  tNotice.txt=pInit.tMsg.txt
  if(pInit.vBusy.val==0&&dp==pInit.vPage.val)
  {
  if(pInit.vStep.val==0)
  {
  pInit.vGet.val=0
  if(pInit.vBusy.val==0)
  {
  pInit.vSeq.val+=1
  pInit.nAckSeq.val=0
  pInit.vBusy.val=1
  pInit.vRetry.val=0
  pInit.vTask.val=0
  pInit.tReq.txt="CM1|"
  covx pInit.nBoot.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vSeq.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vPage.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.nView.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  pInit.tReq.txt+="PAGE_READY"
  prints pInit.tReq.txt,0
  printh 0A
  }
  }
  if(pInit.vStep.val==1)
  {
  pInit.vGet.val=1
  pInit.tCommand.txt="GET|status"
  if(pInit.vBusy.val==0)
  {
  pInit.vSeq.val+=1
  pInit.nAckSeq.val=0
  pInit.vBusy.val=1
  pInit.vRetry.val=0
  pInit.vTask.val=0
  pInit.tReq.txt="CM1|"
  covx pInit.nBoot.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vSeq.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vPage.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.nView.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  pInit.tReq.txt+=pInit.tCommand.txt
  prints pInit.tReq.txt,0
  printh 0A
  }
  }
  if(pInit.vStep.val>1)
  {
  pInit.vPoll.val+=1
  if(pInit.vPoll.val>=5)
  {
  pInit.vPoll.val=0
  pInit.vStep.val=1
  }
  }
  }
