{
  "name": "pMatu",
  "title": "Maturity Data Input",
  "background": "assets/pages/06_maturity_data.png",
  "components": [
    {
      "type": "Picture",
      "objname": "bg",
      "x": 0,
      "y": 0,
      "w": 480,
      "h": 800,
      "pic": "06_maturity_data.png"
    },

    {
      "type": "Variable",
      "objname": "va0",
      "note": "Active maturity row index (0..5). Set by mTemp*; read by MCU on SEN."
    },

    {
      "type": "Text",
      "objname": "tT0",
      "x": 322,
      "y": 294,
      "w": 72,
      "h": 28,
      "txt": "27.4",
      "pco": 65535,
      "bco": 2113
    },
    {
      "type": "Text",
      "objname": "tT1",
      "x": 322,
      "y": 332,
      "w": 72,
      "h": 28,
      "txt": "28.1",
      "pco": 65535,
      "bco": 2113
    },
    {
      "type": "Text",
      "objname": "tT2",
      "x": 322,
      "y": 370,
      "w": 72,
      "h": 28,
      "txt": "29.0",
      "pco": 65535,
      "bco": 2113
    },
    {
      "type": "Text",
      "objname": "tT3",
      "x": 322,
      "y": 408,
      "w": 72,
      "h": 28,
      "txt": "30.2",
      "pco": 65535,
      "bco": 2113
    },
    {
      "type": "Text",
      "objname": "tT4",
      "x": 322,
      "y": 446,
      "w": 72,
      "h": 28,
      "txt": "29.8",
      "pco": 65535,
      "bco": 2113
    },
    {
      "type": "Text",
      "objname": "tT5",
      "x": 322,
      "y": 484,
      "w": 72,
      "h": 28,
      "txt": "28.9",
      "pco": 65535,
      "bco": 2113
    },

    {
      "type": "Text",
      "objname": "tHint",
      "x": 84,
      "y": 616,
      "w": 310,
      "h": 22,
      "txt": "Tap a Temp row, then SENSOR to fill.",
      "pco": 50712
    },

    {
      "type": "TouchCap",
      "objname": "mTemp0",
      "x": 318,
      "y": 288,
      "w": 80,
      "h": 36,
      "label": "Temp row 0",
      "events": { "touchpress": "va0.val=0" }
    },
    {
      "type": "TouchCap",
      "objname": "mTemp1",
      "x": 318,
      "y": 326,
      "w": 80,
      "h": 36,
      "label": "Temp row 1",
      "events": { "touchpress": "va0.val=1" }
    },
    {
      "type": "TouchCap",
      "objname": "mTemp2",
      "x": 318,
      "y": 364,
      "w": 80,
      "h": 36,
      "label": "Temp row 2",
      "events": { "touchpress": "va0.val=2" }
    },
    {
      "type": "TouchCap",
      "objname": "mTemp3",
      "x": 318,
      "y": 402,
      "w": 80,
      "h": 36,
      "label": "Temp row 3",
      "events": { "touchpress": "va0.val=3" }
    },
    {
      "type": "TouchCap",
      "objname": "mTemp4",
      "x": 318,
      "y": 440,
      "w": 80,
      "h": 36,
      "label": "Temp row 4",
      "events": { "touchpress": "va0.val=4" }
    },
    {
      "type": "TouchCap",
      "objname": "mTemp5",
      "x": 318,
      "y": 478,
      "w": 80,
      "h": 36,
      "label": "Temp row 5",
      "events": { "touchpress": "va0.val=5" }
    },

    {
      "type": "TouchCap",
      "objname": "mAddDay",
      "x": 70,
      "y": 520,
      "w": 160,
      "h": 44,
      "label": "+ ADD DAY",
      "events": { "touchpress": "prints \"ADD\\r\\n\",0" }
    },
    {
      "type": "TouchCap",
      "objname": "mSensor",
      "x": 250,
      "y": 520,
      "w": 160,
      "h": 44,
      "label": "SENSOR",
      "events": { "touchpress": "prints \"SEN\\r\\n\",0" },
      "note": "MCU reads va0.val, samples sensors, writes tT{n}.txt"
    },

    {
      "type": "TouchCap",
      "objname": "mBack",
      "x": 70,
      "y": 653,
      "w": 150,
      "h": 42,
      "label": "BACK",
      "events": { "touchpress": "page pMat" }
    },
    {
      "type": "TouchCap",
      "objname": "mGen",
      "x": 241,
      "y": 653,
      "w": 183,
      "h": 42,
      "label": "GENERATE BASELINE",
      "events": { "touchpress": "page pBaseR" }
    }
  ],
  "events": {
    "mTemp0.touchpress": "events/pMatu_mTemp0.txt",
    "mTemp1.touchpress": "events/pMatu_mTemp1.txt",
    "mTemp2.touchpress": "events/pMatu_mTemp2.txt",
    "mTemp3.touchpress": "events/pMatu_mTemp3.txt",
    "mTemp4.touchpress": "events/pMatu_mTemp4.txt",
    "mTemp5.touchpress": "events/pMatu_mTemp5.txt",
    "mAddDay.touchpress": "events/pMatu_mAddDay.txt",
    "mSensor.touchpress": "events/pMatu_mSensor.txt",
    "mBack.touchpress": "events/pMatu_mBack.txt",
    "mGen.touchpress": "events/pMatu_mGen.txt"
  },
  "serialProtocol": {
    "fromHmi": [
      "SEN  — read sensor into active row (va0)",
      "ADD  — request add maturity day row"
    ],
    "fromMcu": [
      "tT0.txt=\"27.4\" … tT5.txt=\"28.9\"  — write temperature cells",
      "tHint.txt=\"Day 7: 25.7 C from sensor\"",
      "Each command ends with 0xFF 0xFF 0xFF"
    ]
  }
}
