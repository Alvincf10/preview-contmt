// Postinitialize: the panel announces PAGE_READY.
on pHistD.loadend:
  // The page starts its conversation at step 0; the timer carries it.
  if(pInit.vBusy.val==0)
  {
  pInit.vStep.val=0
  }

// Timer tmPoll: runs while the page is showing.
on tmPoll.timer:
  // One step per tick: split a finished answer, then ask for the next.
  if(pInit.vBusy.val==1)
  {
  if(pInit.nAckSeq.val==pInit.vSeq.val)
  {
  if(pInit.vSource.val==1)
  {
      // status: 20 columns
      spstr pInit.tData.txt,pInit.tSplit.txt,"|",1
      tClock.txt=pInit.tSplit.txt
      spstr pInit.tData.txt,pInit.tSplit.txt,"|",3
      tBatt.txt=pInit.tSplit.txt
  }
  else if(pInit.vSource.val==9)
  {
      // detail: 19 columns
      spstr pInit.tData.txt,pInit.tSplit.txt,"|",1
      tSavedAt.txt=pInit.tSplit.txt
      spstr pInit.tData.txt,pInit.tSplit.txt,"|",3
      tOp.txt=pInit.tSplit.txt
      spstr pInit.tData.txt,pInit.tSplit.txt,"|",4
      tProj.txt=pInit.tSplit.txt
      spstr pInit.tData.txt,pInit.tSplit.txt,"|",5
      tDate.txt=pInit.tSplit.txt
      spstr pInit.tData.txt,pInit.tSplit.txt,"|",8
      tCount.txt=pInit.tSplit.txt
      spstr pInit.tData.txt,pInit.tSplit.txt,"|",14
      tStatus.txt=pInit.tSplit.txt
      spstr pInit.tData.txt,pInit.tSplit.txt,"|",16
      tM.txt=pInit.tSplit.txt
      spstr pInit.tData.txt,pInit.tSplit.txt,"|",17
      tFc.txt=pInit.tSplit.txt
      spstr pInit.tData.txt,pInit.tSplit.txt,"|",18
      tPct.txt=pInit.tSplit.txt
  }
  else if(pInit.vSource.val==10)
  {
      // point: 13 columns
      spstr pInit.tData.txt,pInit.tSplit.txt,"|",8
      tS1.txt=pInit.tSplit.txt
      spstr pInit.tData.txt,pInit.tSplit.txt,"|",9
      tS2.txt=pInit.tSplit.txt
      spstr pInit.tData.txt,pInit.tSplit.txt,"|",10
      tS3.txt=pInit.tSplit.txt
  }
  pInit.vStep.val+=1
  pInit.vBusy.val=0
  pInit.vRetry.val=0
  }else
  {
  pInit.vRetry.val+=1
  if(pInit.vRetry.val<6)
  {
  prints pInit.tReq.txt,0
  printh 0A
  }else
  {
  pInit.vBusy.val=0
  pInit.vRetry.val=0
  pInit.vStep.val+=1
  pInit.tMsg.txt="No answer from MCU"
  }
  }
  }
  // Ask for the next thing this page needs.
  if(pInit.vBusy.val==0&&pInit.vStep.val>=0)
  {
  if(pInit.vStep.val==0)
  {
    if(pInit.vBusy.val==0)
    {
    pInit.vSeq.val+=1
    pInit.vBusy.val=1
    pInit.vRetry.val=0
    pInit.tReq.txt="CM1|"
    covx pInit.nBoot.val,pInit.tNum.txt,0,0
    pInit.tReq.txt+=pInit.tNum.txt
    pInit.tReq.txt+="|"
    covx pInit.vSeq.val,pInit.tNum.txt,0,0
    pInit.tReq.txt+=pInit.tNum.txt
    pInit.tReq.txt+="|"
    pInit.tReq.txt+="14|"
    covx pInit.nView.val,pInit.tNum.txt,0,0
    pInit.tReq.txt+=pInit.tNum.txt
    pInit.tReq.txt+="|PAGE_READY"
    pInit.vSource.val=1
    prints pInit.tReq.txt,0
    printh 0A
    }
  }
  else if(pInit.vStep.val==1)
  {
    if(pInit.vBusy.val==0)
    {
    pInit.vSeq.val+=1
    pInit.vBusy.val=1
    pInit.vRetry.val=0
    pInit.tReq.txt="CM1|"
    covx pInit.nBoot.val,pInit.tNum.txt,0,0
    pInit.tReq.txt+=pInit.tNum.txt
    pInit.tReq.txt+="|"
    covx pInit.vSeq.val,pInit.tNum.txt,0,0
    pInit.tReq.txt+=pInit.tNum.txt
    pInit.tReq.txt+="|"
    pInit.tReq.txt+="14|"
    covx pInit.nView.val,pInit.tNum.txt,0,0
    pInit.tReq.txt+=pInit.tNum.txt
    pInit.tReq.txt+="|GET"
    pInit.tReq.txt+="|"
    pInit.tReq.txt+="detail"
    pInit.vSource.val=9
    prints pInit.tReq.txt,0
    printh 0A
    }
  }
  else if(pInit.vStep.val==2)
  {
    if(pInit.vBusy.val==0)
    {
    pInit.vSeq.val+=1
    pInit.vBusy.val=1
    pInit.vRetry.val=0
    pInit.tReq.txt="CM1|"
    covx pInit.nBoot.val,pInit.tNum.txt,0,0
    pInit.tReq.txt+=pInit.tNum.txt
    pInit.tReq.txt+="|"
    covx pInit.vSeq.val,pInit.tNum.txt,0,0
    pInit.tReq.txt+=pInit.tNum.txt
    pInit.tReq.txt+="|"
    pInit.tReq.txt+="14|"
    covx pInit.nView.val,pInit.tNum.txt,0,0
    pInit.tReq.txt+=pInit.tNum.txt
    pInit.tReq.txt+="|GET"
    pInit.tReq.txt+="|"
    pInit.tReq.txt+="run"
    pInit.vSource.val=8
    prints pInit.tReq.txt,0
    printh 0A
    }
  }
  else if(pInit.vStep.val==3)
  {
    if(pInit.vBusy.val==0)
    {
    pInit.vSeq.val+=1
    pInit.vBusy.val=1
    pInit.vRetry.val=0
    pInit.tReq.txt="CM1|"
    covx pInit.nBoot.val,pInit.tNum.txt,0,0
    pInit.tReq.txt+=pInit.tNum.txt
    pInit.tReq.txt+="|"
    covx pInit.vSeq.val,pInit.tNum.txt,0,0
    pInit.tReq.txt+=pInit.tNum.txt
    pInit.tReq.txt+="|"
    pInit.tReq.txt+="14|"
    covx pInit.nView.val,pInit.tNum.txt,0,0
    pInit.tReq.txt+=pInit.tNum.txt
    pInit.tReq.txt+="|GET"
    pInit.tReq.txt+="|"
    pInit.tReq.txt+="point"
    pInit.vSource.val=10
    prints pInit.tReq.txt,0
    printh 0A
    }
  }
  }

on mBack.down:
  if(pInit.vBusy.val==0)
  {
  pInit.vSeq.val+=1
  pInit.vBusy.val=1
  pInit.vRetry.val=0
  pInit.tReq.txt="CM1|"
  covx pInit.nBoot.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  covx pInit.vSeq.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|"
  pInit.tReq.txt+="14|"
  covx pInit.nView.val,pInit.tNum.txt,0,0
  pInit.tReq.txt+=pInit.tNum.txt
  pInit.tReq.txt+="|NAV"
  pInit.tReq.txt+="|"
  pInit.tReq.txt+="BACK"
  prints pInit.tReq.txt,0
  printh 0A
  }

