{
  "purpose": "capacity probe, never upload",
  "compiler": "avr-g++ (GCC) 7.3.0",
  "flashBytes": 83072,
  "staticRamBytes": 1685,
  "physicalFlashRemaining": -50304,
  "staticRamRemaining": 363,
  "fitsStaticLimits": false,
  "includes": "shared core/controller/HMI/real SD/HardwareSerial; probe clock/sensor/device ports",
  "excludes": "verified sensor/RTC/battery drivers, actual stack watermark",
  "clockAssumption": "16MHz for capacity only; not board configuration",
  "strategy": "inline-relax",
  "compilerFlags": [
    "-mmcu=atmega328p",
    "-Os",
    "-flto",
    "-mcall-prologues",
    "-fno-inline-functions-called-once",
    "-ffunction-sections",
    "-fdata-sections",
    "-fno-exceptions",
    "-fno-threadsafe-statics",
    "-fno-rtti",
    "-fstack-usage",
    "-std=gnu++11",
    "-DARDUINO=10819",
    "-DARDUINO_ARCH_AVR",
    "-DF_CPU=16000000UL",
    "-mrelax",
    "-fmerge-all-constants"
  ],
  "nativeLinkPassed": false,
  "physicalRegionLimits": {
    "flash": 32768,
    "sram": 2048
  }
}
