on pHist.loadend:
  if(pInit.vPage.val!=13)
  {
  pInit.vOffset.val=0
  if(pInit.vPage.val==14)
  {
  pInit.vOffset.val=pInit.vHistoryOffset.val
  }
  }
  pInit.vPage.val=13
  pInit.vBusy.val=0
  pInit.vRetry.val=0
  pInit.vStep.val=0
  pInit.vPoll.val=0
  pInit.vTap.val=0
  pInit.vStatusReady.val=0
  pInit.vTask.val=0
  pInit.tMsg.txt=""
  tClock.txt="--:--"
  tBatt.txt="--%"
  tBatt.pco=65535
  pInit.vTemp.val=0
  picq 367,82,22,22,21
  if(pInit.vTemp.val>0)
  {
  fill 371,90,pInit.vTemp.val,6,tBatt.pco
  }
  pInit.vHistoryEnd.val=-1
  tsw mDetail,0
  vis mDetail,0
  tId0.txt=""
  tName0.txt=""
  tVal0.txt=""
  tDate0.txt=""
  tCount0.txt=""
  vHist0.val=0
  tsw mHistory0,0
  picq 67,250,346,120,21
  tId1.txt=""
  tName1.txt=""
  tVal1.txt=""
  tDate1.txt=""
  tCount1.txt=""
  vHist1.val=0
  tsw mHistory1,0
  picq 67,380,346,120,21
  tId2.txt=""
  tName2.txt=""
  tVal2.txt=""
  tDate2.txt=""
  tCount2.txt=""
  vHist2.val=0
  tsw mHistory2,0
  picq 67,510,346,120,21
  tmDrag.en=0
  vBlockTap.val=0
  pInit.vTouchPhase.val=0
  pInit.vListBase.val=pInit.vOffset.val
  pInit.vListShift.val=0
  pInit.vListReuse.val=0
  pInit.vListDirty.val=1
  pInit.vListReady.val=0

on tcList.down:
  if(pInit.vTouchPhase.val==2)
  {
  pInit.vTap.val=0
  }
  tmDrag.en=0
  pInit.vTouchPhase.val=0
  vBlockTap.val=0
  vStartX.val=tch0
  vStartY.val=tch1
  if(vStartX.val>=67&&vStartX.val<421&&vStartY.val>=250&&vStartY.val<630)
  {
  pInit.vTouchPhase.val=1
  vPriorX.val=tch2
  vPriorY.val=tch3
  vDragX.val=0
  vDragY.val=0
  tmDrag.en=1
  if(pInit.vListReady.val==0||pInit.vListShift.val!=0)
  {
  vBlockTap.val=1
  }
  }

on tcList.up:
  if(pInit.vTouchPhase.val==1)
  {
  pInit.vTouchPhase.val=2
  }

on tmDrag.timer:
  if(pInit.vTouchPhase.val==1)
  {
  if(tch0!=0||tch1!=0)
  {
  vDragX.val=tch0-vStartX.val
  if(vDragX.val<0)
  {
  vDragX.val*=-1
  }
  vDragY.val=vStartY.val-tch1
  if(vDragX.val>=16||vDragY.val>=16||vDragY.val<=-16)
  {
  vBlockTap.val=1
  }
  }
  }
  else
  {
  tmDrag.en=0
  pInit.vTouchPhase.val=0
  if(tch0==0&&tch1==0)
  {
  if(tch2!=vPriorX.val||tch3!=vPriorY.val)
  {
  if(tch2>=0&&tch2<480&&tch3>=0&&tch3<800)
  {
  vDragX.val=tch2-vStartX.val
  if(vDragX.val<0)
  {
  vDragX.val*=-1
  }
  vDragY.val=vStartY.val-tch3
  if(vDragX.val>=16||vDragY.val>=16||vDragY.val<=-16)
  {
  vBlockTap.val=1
  }
  }
  }
  pInit.vTemp.val=vDragY.val
  if(pInit.vTemp.val<0)
  {
  pInit.vTemp.val*=-1
  }
  if(pInit.vTemp.val>=22&&pInit.vTemp.val>vDragX.val)
  {
  pInit.vTemp.val+=65
  pInit.vTemp.val/=130
  if(pInit.vTemp.val<1)
  {
  pInit.vTemp.val=1
  }
  if(vDragY.val>0)
  {
  pInit.vListShift.val+=pInit.vTemp.val
  }else
  {
  pInit.vListShift.val-=pInit.vTemp.val
  }
  vBlockTap.val=1
  }
  }
  else
  {
  vBlockTap.val=1
  }
  if(vBlockTap.val==1)
  {
  pInit.vTap.val=0
  }
  }

on tmPoll.timer:
  if(pInit.vBusy.val==1)
  {
  if(pInit.nAckSeq.val==pInit.vSeq.val)
  {
  pInit.vBusy.val=0
  pInit.vRetry.val=0
  if(pInit.nAckCode.val==4||pInit.nAckCode.val==8)
  {
  pInit.nBoot.val=0
  pInit.vStep.val=0
  pInit.vTap.val=0
  pInit.vStatusReady.val=0
  }else
  {
  if(pInit.vTask.val==0)
  {
  if(pInit.vGet.val==1)
  {
  if(pInit.nAckCode.val==0)
  {
  pInit.vIndex.val=pInit.vStorage.val
  pInit.tStatus.txt=pInit.tData.txt
  spstr pInit.tData.txt,pInit.tTime.txt,"|",1
  tClock.txt="--:--"
  if(pInit.tTime.txt!="")
  {
  substr pInit.tTime.txt,tClock.txt,0,5
  }
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",3
  tBatt.txt="--%"
  tBatt.pco=65535
  pInit.vTemp.val=0
  if(pInit.tSplit.txt!="")
  {
  covx pInit.tSplit.txt,pInit.vTemp.val,0,0
  tBatt.txt=pInit.tSplit.txt
  tBatt.txt+="%"
  if(pInit.vTemp.val<=40)
  {
  tBatt.pco=65132
  }
  if(pInit.vTemp.val<=20)
  {
  tBatt.pco=64329
  }
  pInit.vTemp.val*=11
  pInit.vTemp.val+=50
  pInit.vTemp.val/=100
  }
  picq 367,82,22,22,21
  if(pInit.vTemp.val>0)
  {
  fill 371,90,pInit.vTemp.val,6,tBatt.pco
  }
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",4
  covx pInit.tSplit.txt,pInit.vStorage.val,0,0
  spstr pInit.tData.txt,pInit.tDate.txt,"|",0
  spstr pInit.tData.txt,pInit.tSplit.txt,"|",14
  covx pInit.tSplit.txt,pInit.vMask.val,0,0
  pInit.vSensors.val=0
  pInit.vCount.val=pInit.vMask.val
  if(pInit.vCount.val>=4)
  {
  pInit.vSensors.val+=1
  pInit.vCount.val-=4
  }
  if(pInit.vCount.val>=2)
  {
  pInit.vSensors.val+=1
  pInit.vCount.val-=2
  }
  if(pInit.vCount.val>=1)
  {
  pInit.vSensors.val+=1
  }
  if(pInit.vIndex.val!=pInit.vStorage.val)
  {
  pInit.vListDirty.val=1
  }
  pInit.vStatusReady.val=1
  }
  }
  if(pInit.vGet.val==2)
  {
  pInit.vIndex.val=pInit.vListBase.val+0
  if(pInit.nAckCode.val==15&&pInit.vHistoryEnd.val!=pInit.vIndex.val)
  {
  pInit.vHistoryEnd.val=pInit.vIndex.val
  pInit.vListDirty.val=1
  }
  if(pInit.nAckCode.val==0&&pInit.vHistoryEnd.val>=0&&pInit.vIndex.val>=pInit.vHistoryEnd.val)
  {
  pInit.vHistoryEnd.val=-1
  pInit.vListDirty.val=1
  }
  if(pInit.nAckCode.val!=0)
  {
  pInit.tData.txt=""
  }
  if(tRowData0.txt!=pInit.tData.txt)
  {
  tRowData0.txt=pInit.tData.txt
  pInit.vListDirty.val=1
  }
  }
  if(pInit.vGet.val==3)
  {
  pInit.vIndex.val=pInit.vListBase.val+1
  if(pInit.nAckCode.val==15&&pInit.vHistoryEnd.val!=pInit.vIndex.val)
  {
  pInit.vHistoryEnd.val=pInit.vIndex.val
  pInit.vListDirty.val=1
  }
  if(pInit.nAckCode.val==0&&pInit.vHistoryEnd.val>=0&&pInit.vIndex.val>=pInit.vHistoryEnd.val)
  {
  pInit.vHistoryEnd.val=-1
  pInit.vListDirty.val=1
  }
  if(pInit.nAckCode.val!=0)
  {
  pInit.tData.txt=""
  }
  if(tRowData1.txt!=pInit.tData.txt)
  {
  tRowData1.txt=pInit.tData.txt
  pInit.vListDirty.val=1
  }
  }
  if(pInit.vGet.val==4)
  {
  pInit.vIndex.val=pInit.vListBase.val+2
  if(pInit.nAckCode.val==15&&pInit.vHistoryEnd.val!=pInit.vIndex.val)
  {
  pInit.vHistoryEnd.val=pInit.vIndex.val
  pInit.vListDirty.val=1
  }
  if(pInit.nAckCode.val==0&&pInit.vHistoryEnd.val>=0&&pInit.vIndex.val>=pInit.vHistoryEnd.val)
  {
  pInit.vHistoryEnd.val=-1
  pInit.vListDirty.val=1
  }
  if(pInit.nAckCode.val!=0)
  {
  pInit.tData.txt=""
  }
  if(tRowData2.txt!=pInit.tData.txt)
  {
  tRowData2.txt=pInit.tData.txt
  pInit.vListDirty.val=1
  }
  }
  if(pInit.vGet.val==5)
  {
  pInit.vIndex.val=pInit.vListBase.val+3
  if(pInit.nAckCode.val==15&&pInit.vHistoryEnd.val!=pInit.vIndex.val)
  {
  pInit.vHistoryEnd.val=pInit.vIndex.val
  pInit.vListDirty.val=1
  }
  if(pInit.nAckCode.val==0&&pInit.vHistoryEnd.val>=0&&pInit.vIndex.val>=pInit.vHistoryEnd.val)
  {
  pInit.vHistoryEnd.val=-1
  pInit.vListDirty.val=1
  }
  }
  pInit.vStep.val+=1
  }else
  {
  if(pInit.nAckCode.val==13)
  {
  pInit.vToken.val=pInit.nAckValue.val
  page pConfirm
  }else
  {
