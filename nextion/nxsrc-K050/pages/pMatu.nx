on pMatu.loadend:
  if(pInit.vPage.val!=6)
  {
  pInit.vOffset.val=0
  if(pInit.vPage.val==7)
  {
  pInit.vOffset.val=pInit.vMatuOffset.val
  }
  else
  {
  pInit.vFocusId.val=0
  pInit.vFocusFirst.val=0
  pInit.vFocusRow.val=0
  }
  }
  pInit.vPage.val=6
  pInit.vBusy.val=0
  pInit.vRetry.val=0
  pInit.vStep.val=0
  pInit.vPoll.val=0
  pInit.vTap.val=0
  pInit.vStatusReady.val=0
  pInit.vTask.val=0
  pInit.tMsg.txt=""
  tClock.txt="--:--"
  tBatt.txt="--%"
  tBatt.pco=65535
  pInit.vTemp.val=0
  picq 367,82,22,22,9
  if(pInit.vTemp.val>0)
  {
  fill 371,90,pInit.vTemp.val,6,tBatt.pco
  }
  pInit.vLab0.val=0
  tsw tDay0,0
  vis tDay0,0
  tsw tTim0,0
  vis tTim0,0
  tsw tFc0,0
  vis tFc0,0
  tsw tT0,0
  vis tT0,0
  tsw mDelete0,0
  vis mDelete0,0
  picq 68,253,344,57,9
  pInit.vLab1.val=0
  tsw tDay1,0
  vis tDay1,0
  tsw tTim1,0
  vis tTim1,0
  tsw tFc1,0
  vis tFc1,0
  tsw tT1,0
  vis tT1,0
  tsw mDelete1,0
  vis mDelete1,0
  picq 68,310,344,57,9
  pInit.vLab2.val=0
  tsw tDay2,0
